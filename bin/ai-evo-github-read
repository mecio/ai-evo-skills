#!/usr/bin/env python3
"""Fixed, authenticated GitHub reads for restricted adapters; no arbitrary gh options."""

import os
import re
import subprocess
import sys


def command(arguments):
    if arguments == ["auth-status"]:
        return ["gh", "auth", "status", "--hostname", "github.com"]
    if arguments == ["repo-view"]:
        return ["gh", "repo", "view", "--json", "nameWithOwner,url,defaultBranchRef"]
    if len(arguments) == 2 and arguments[0] == "issue-view" and re.fullmatch(r"[1-9][0-9]*", arguments[1]):
        return ["gh", "issue", "view", arguments[1], "--json",
                "number,url,state,title,body,comments,labels,milestone,assignees"]
    raise ValueError("expected auth-status, repo-view or issue-view <positive-number>; no other arguments allowed")


def main():
    try:
        argv = command(sys.argv[1:])
        # Use the checkout's repository, never an inherited GH_REPO override.
        env = {key: value for key, value in os.environ.items()
               if key not in {"GH_REPO", "GH_DEBUG", "DEBUG"}}
        env.update(GH_HOST="github.com", GH_PROMPT_DISABLED="1", GH_PAGER="cat",
                   PAGER="cat", GH_NO_UPDATE_NOTIFIER="1", GH_NO_EXTENSION_UPDATE_NOTIFIER="1",
                   GIT_OPTIONAL_LOCKS="0", GIT_TERMINAL_PROMPT="0")
        result = subprocess.run(argv, env=env, capture_output=True, timeout=60, check=False)
        if sys.argv[1] == "auth-status":
            # Do not forward account/token diagnostics (including on failure).
            stream = sys.stdout if result.returncode == 0 else sys.stderr
            print("GitHub authentication available" if result.returncode == 0
                  else "error: GitHub authentication unavailable; configure gh outside this command", file=stream)
        else:
            sys.stdout.buffer.write(result.stdout)
            sys.stderr.buffer.write(result.stderr)
        return result.returncode
    except (OSError, ValueError, subprocess.TimeoutExpired) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
