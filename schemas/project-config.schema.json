{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-evo-skills:schema:project-config:1.0",
  "title": "AI Evo Skills project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "namespace", "targets"],
  "properties": {
    "version": { "const": "1.0" },
    "namespace": { "type": "string", "pattern": "^[a-z]{3,6}$" },
    "ignore-file": { "enum": ["git-exclude", "gitignore", "none"] },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "adapter", "path", "enabled"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "adapter": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "path": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean" }
        }
      }
    }
  }
}
