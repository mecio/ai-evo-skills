#!/usr/bin/env python3
"""Validate an acme commit message without creating a commit."""

from __future__ import annotations

import argparse
import re
from pathlib import Path

from lib.acme_script_common import write_json


FORBIDDEN = re.compile(
    r"(?im)^(?:co-authored-by|signed-off-by|assisted-by):|generated\s+with.*(?:ai|claude|codex|chatgpt)"
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--message-file", type=Path, required=True)
    parser.add_argument("--issue-number", required=True)
    return parser.parse_args()


def validate_message(message: str, issue_number: str) -> dict:
    errors: list[str] = []
    if not re.fullmatch(r"[1-9][0-9]*", issue_number):
        errors.append("issue-number must be a positive integer")
    if "\x00" in message or "\r" in message:
        errors.append("message contains NUL or carriage-return characters")
    lines = message.rstrip("\n").split("\n") if message else []
    title = lines[0] if lines else ""
    expected = f"#{issue_number} "
    if not title.startswith(expected):
        errors.append(f"title must start with {expected!r}")
    if len(title) > 72:
        errors.append(f"title is {len(title)} characters; maximum is 72")
    if len(lines) < 3 or lines[1] != "" or not any(line.strip() for line in lines[2:]):
        errors.append("message must contain a blank line followed by a non-empty body")
    if FORBIDDEN.search(message):
        errors.append("message contains a forbidden attribution or trailer")
    return {
        "schema_version": 1,
        "valid": not errors,
        "issue_number": issue_number,
        "title": title,
        "title_length": len(title),
        "errors": errors,
    }


def main() -> int:
    args = parse_args()
    try:
        message = args.message_file.read_text(encoding="utf-8")
    except OSError as exc:
        data = validate_message("", args.issue_number)
        data["errors"].append(f"cannot read message file: {exc}")
        write_json(data)
        return 1
    data = validate_message(message, args.issue_number)
    write_json(data)
    return 0 if data["valid"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
