#!/usr/bin/env python3
"""Restore a recipe branch and reconstruct a published gh stack from its worklog when needed."""

from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

from lib.acme_script_common import fail, git, git_text, load_simple_yaml, write_json
from lib.acme_worklog_recovery import order_layers, published_layers, registered_branch


ROOT = Path(__file__).resolve().parent.parent
BRANCH_CONFIG = ROOT / "skills/config/acme-git-branches.yaml"
ENV = {**os.environ, "GIT_TERMINAL_PROMPT": "0", "GIT_PAGER": "cat"}


def run(*arguments: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    completed = subprocess.run(arguments, env=ENV, capture_output=True, text=True, check=False)
    if check and completed.returncode:
        fail(completed.stderr.strip() or completed.stdout.strip() or f"command failed: {arguments[0]}")
    return completed


def checked_branch(value: object, field: str = "branch") -> str:
    if not isinstance(value, str) or not value or value.startswith("-"):
        fail(f"{field} is invalid")
    git("check-ref-format", "--branch", value)
    return value


def parse_request(raw: str) -> tuple[int, str, str]:
    try:
        request = json.loads(raw)
    except json.JSONDecodeError as exc:
        fail(f"request is not valid JSON: {exc}")
    if not isinstance(request, dict) or set(request) - {"issue", "worklog_session", "branch"}:
        fail("request fields do not match the operation contract")
    issue = request.get("issue")
    if isinstance(issue, str) and issue.isdigit():
        issue = int(issue)
    if type(issue) is not int or issue < 1:
        fail("issue must be a positive integer")
    session = request.get("worklog_session", "")
    if not isinstance(session, str):
        fail("worklog_session is invalid")
    branch = request.get("branch", "")
    return issue, session, checked_branch(branch) if branch else ""


def clean_worktree() -> None:
    if git("status", "--porcelain=v1", "-z").stdout:
        fail("worktree must be clean")


def configured_remote() -> str:
    remote = load_simple_yaml(BRANCH_CONFIG).get("stack_remote")
    if not isinstance(remote, str) or not remote or remote.startswith("-"):
        fail("stack_remote is missing from branch configuration")
    git("remote", "get-url", remote)
    return remote


def local_branch_exists(branch: str) -> bool:
    return git("show-ref", "--verify", "--quiet", f"refs/heads/{branch}", check=False).returncode == 0


def remote_branch_exists(remote: str, branch: str) -> bool:
    return git("show-ref", "--verify", "--quiet", f"refs/remotes/{remote}/{branch}", check=False).returncode == 0


def ancestor(older: str, newer: str) -> bool:
    return git("merge-base", "--is-ancestor", older, newer, check=False).returncode == 0


def merge_base(left: str, right: str) -> str:
    result = git("merge-base", left, right, check=False)
    return result.stdout.strip() if result.returncode == 0 else ""


def advanced_trunk_base(trunk_ref: str, layer_ref: str, layer: dict[str, str]) -> str:
    """Return the former base when only the trunk advanced, otherwise fail."""
    base = merge_base(trunk_ref, layer_ref)
    if not base or not ancestor(base, trunk_ref):
        fail(f"published stack is not linear: {layer['parent_branch']} is not an ancestor of {layer['branch']}")
    total = git_text("rev-list", "--count", f"{base}..{layer_ref}")
    exclusive = git_text("rev-list", "--count", f"{base}..{layer_ref}", "--not", trunk_ref)
    if total != exclusive:
        fail(f"published stack is not linear: {layer['parent_branch']} is not an ancestor of {layer['branch']}")
    for checkpoint in (layer.get("base_oid", ""), layer.get("parent_oid", "")):
        if checkpoint and not ancestor(checkpoint, base):
            fail(f"published stack is not linear: {layer['parent_branch']} is not an ancestor of {layer['branch']}")
    return base


def verify_published_chain(remote: str, trunk: str, layers: list[dict[str, str]]) -> tuple[bool, str, str]:
    if not local_branch_exists(trunk):
        fail(f"local trunk branch does not exist: {trunk}")
    trunk_ref = f"refs/remotes/{remote}/{trunk}" if remote_branch_exists(remote, trunk) else f"refs/heads/{trunk}"
    trunk_oid = git_text("rev-parse", trunk_ref)
    rebase_required = False
    layer_base_oid = ""
    for index, layer in enumerate(layers):
        branch = checked_branch(layer["branch"])
        parent = checked_branch(layer["parent_branch"], "parent_branch")
        if layer["remote"] != remote:
            fail(f"worklog remote for {branch} is {layer['remote']}, expected {remote}")
        if not remote_branch_exists(remote, branch):
            fail(f"published remote branch does not exist: {remote}/{branch}")
        remote_ref = f"refs/remotes/{remote}/{branch}"
        if not ancestor(layer["remote_oid"], remote_ref):
            fail(f"remote branch was rewritten or no longer contains the published OID: {branch}")
        parent_ref = f"refs/remotes/{remote}/{parent}" if remote_branch_exists(remote, parent) else f"refs/heads/{parent}"
        if not ancestor(parent_ref, remote_ref):
            if index != 0 or parent != trunk:
                fail(f"published stack is not linear: {parent} is not an ancestor of {branch}")
            layer_base_oid = advanced_trunk_base(trunk_ref, remote_ref, layer)
            rebase_required = True
        if local_branch_exists(branch):
            local_ref = f"refs/heads/{branch}"
            if not ancestor(local_ref, remote_ref):
                if patch_equivalent(remote_ref, local_ref):
                    fail(f"reset-to-remote-required: local branch {branch} is an old patch-equivalent pre-rebase "
                         f"copy; reset it to {remote}/{branch} before prepare")
                fail(f"local branch diverges from the published remote branch and has local-only commits: {branch}")
            upstream = git_text("for-each-ref", "--format=%(upstream:short)", local_ref)
            expected = f"{remote}/{branch}"
            if upstream and upstream != expected:
                fail(f"branch upstream is {upstream}, expected {expected}")
    return rebase_required, trunk_oid, layer_base_oid


def patch_ids(base: str, tip: str) -> list[str] | None:
    commits = git_text("rev-list", "--reverse", f"{base}..{tip}").splitlines()
    values: list[str] = []
    for commit in commits:
        shown = run("git", "show", "--format=", "--no-ext-diff", commit, check=False)
        # patch-id reads stdin; use a dedicated invocation so no shell quoting is involved.
        patch = subprocess.run(["git", "patch-id", "--stable"], input=shown.stdout, text=True,
                               capture_output=True, env=ENV, check=False)
        if patch.returncode or not patch.stdout.split():
            return None
        values.append(patch.stdout.split()[0])
    return values


def patch_equivalent(remote_ref: str, local_ref: str) -> bool:
    base = merge_base(remote_ref, local_ref)
    if not base:
        return False
    local, remote = patch_ids(base, local_ref), patch_ids(base, remote_ref)
    return local is not None and local == remote


def stale_stack_diagnosis(trunk: str, ordered: list[dict[str, str]]) -> str | None:
    """Reject only gh-stack metadata that disagrees with the published chain."""
    path = Path(git_text("rev-parse", "--git-path", "gh-stack"))
    if not path.is_absolute():
        path = Path(git_text("rev-parse", "--show-toplevel")) / path
    if not path.is_file():
        return None
    try:
        stacks = json.loads(path.read_text(encoding="utf-8")).get("stacks", [])
    except (OSError, UnicodeError, json.JSONDecodeError):
        return "gh-stack metadata is unreadable; inspect it before recovery"
    expected = [layer["branch"] for layer in ordered]
    registered = set(expected)
    for stack in stacks if isinstance(stacks, list) else []:
        if not isinstance(stack, dict):
            continue
        branches = stack.get("branches", [])
        names = [item.get("branch") for item in branches if isinstance(item, dict) and isinstance(item.get("branch"), str)]
        stack_trunk = stack.get("trunk", {}).get("branch") if isinstance(stack.get("trunk"), dict) else ""
        if not names or not set(names) & registered:
            continue
        published = all(local_branch_exists(layer["branch"]) and ancestor(layer["remote_oid"], f"refs/heads/{layer['branch']}")
                        for layer in ordered)
        if stack_trunk == trunk and names == expected and published:
            return None
        tip = names[-1]
        return ("stale local gh stack disagrees with the published worklog chain; no local state was changed. "
                f"Recover it explicitly with `gh stack checkout {tip}` then `gh stack unstack --local`, "
                "or remove that tracking only after confirming it is obsolete")
    return None


def materialize_branch(remote: str, branch: str) -> None:
    remote_ref = f"refs/remotes/{remote}/{branch}"
    if local_branch_exists(branch):
        old = git_text("rev-parse", f"refs/heads/{branch}")
        new = git_text("rev-parse", remote_ref)
        if old != new:
            run("git", "update-ref", f"refs/heads/{branch}", new, old)
        return
    run("git", "branch", "--track", branch, remote_ref)


def tracked_checkout(branch: str) -> bool:
    return run("gh", "stack", "checkout", branch, check=False).returncode == 0


def require_upstream(branch: str, remote: str) -> str:
    upstream = git_text("for-each-ref", "--format=%(upstream:short)", f"refs/heads/{branch}")
    expected = f"{remote}/{branch}"
    if upstream != expected:
        fail(f"branch upstream is {upstream or 'unset'}, expected {expected}")
    return upstream


def branch_snapshot() -> tuple[str, set[str]]:
    return (git_text("symbolic-ref", "--quiet", "--short", "HEAD"),
            set(git_text("for-each-ref", "--format=%(refname:short)", "refs/heads").splitlines()))


def rollback_created_branches(initial_branch: str, before: set[str]) -> str:
    """Restore HEAD and delete only branches absent from the preflight snapshot."""
    details: list[str] = []
    if initial_branch:
        restored = run("git", "switch", initial_branch, check=False)
        details.append("HEAD restored" if restored.returncode == 0 else "HEAD restore failed")
    after = set(git_text("for-each-ref", "--format=%(refname:short)", "refs/heads").splitlines())
    created = sorted(after - before)
    for branch in created:
        removed = run("git", "update-ref", "-d", f"refs/heads/{branch}", check=False)
        if removed.returncode:
            details.append(f"could not remove {branch}")
    if created and all(f"could not remove {branch}" not in details for branch in created):
        details.append("created tracking branches removed")
    return "; ".join(details) if details else "no local changes to restore"


def main() -> int:
    if len(sys.argv) != 3 or sys.argv[1] != "prepare":
        fail("expected the prepare operation and one JSON request")
    root = Path(git_text("rev-parse", "--show-toplevel")).resolve()
    if Path.cwd().resolve() != root:
        fail("run from the application Git root")
    issue, session, expected_branch = parse_request(sys.argv[2])
    clean_worktree()
    remote = configured_remote()
    run("git", "fetch", "--prune", remote)
    layers = published_layers(root, issue, session)
    fallback_branch = expected_branch or registered_branch(root, issue, session)
    if layers:
        trunk, ordered = order_layers(layers, expected_branch)
        target = ordered[-1]["branch"]
        rebase_required, trunk_oid, layer_base_oid = verify_published_chain(remote, trunk, ordered)
        diagnosis = stale_stack_diagnosis(trunk, ordered)
        if diagnosis:
            fail(diagnosis)
        initial_branch, before = branch_snapshot()
        try:
            if tracked_checkout(target):
                action = "stack-checked-out"
            else:
                for layer in ordered:
                    materialize_branch(remote, layer["branch"])
                initialized = run("gh", "stack", "init", "--base", trunk, *(layer["branch"] for layer in ordered), check=False)
                if initialized.returncode:
                    if not rebase_required:
                        fail(initialized.stderr.strip() or initialized.stdout.strip() or "gh stack init failed")
                    # gh stack may reject a stack whose trunk advanced. Tracking
                    # refs are still sufficient to recover it for a later rebase.
                run("git", "switch", target)
                action = "stack-reconstructed"
            current = git_text("symbolic-ref", "--quiet", "--short", "HEAD")
            if current != target:
                fail(f"current branch is {current or 'detached'}, expected {target}")
            upstream = require_upstream(target, remote)
            run("git", "pull", "--ff-only")
        except SystemExit as exc:
            restored = rollback_created_branches(initial_branch, before)
            fail(f"{exc} (rollback: {restored})")
    else:
        if not fallback_branch:
            fail("worklog has no published branch and no registered branch for stack checkout")
        initial_branch, before = branch_snapshot()
        try:
            run("gh", "stack", "checkout", fallback_branch)
            upstream = require_upstream(fallback_branch, remote)
            run("git", "pull", "--ff-only")
        except SystemExit as exc:
            restored = rollback_created_branches(initial_branch, before)
            fail(f"{exc} (rollback: {restored})")
        target = fallback_branch
        action = "stack-checked-out"
        rebase_required = False
        trunk = ""
        trunk_oid = ""
        layer_base_oid = ""
    write_json({"status": "prepared", "branch": target, "remote": remote, "upstream": upstream,
                "action": action, "oid": git_text("rev-parse", "HEAD"),
                "rebase_required": rebase_required, "trunk": trunk, "trunk_oid": trunk_oid,
                "layer_base_oid": layer_base_oid})
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
