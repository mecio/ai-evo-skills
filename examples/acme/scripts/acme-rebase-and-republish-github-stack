#!/usr/bin/env python3
"""Rebase a published stack and record its verified republication."""

from __future__ import annotations

import json
import subprocess
import sys
from pathlib import Path
from typing import Any

from lib.acme_script_common import fail, write_json


HERE = Path(__file__).resolve().parent


def run_json(*arguments: str, cwd: Path) -> dict[str, Any]:
    result = subprocess.run(arguments, cwd=cwd, capture_output=True, text=True, check=False)
    if result.returncode:
        fail(result.stderr.strip() or result.stdout.strip() or f"command failed: {arguments[0]}")
    try:
        value = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        fail(f"command output is not valid JSON: {exc}")
    if not isinstance(value, dict):
        fail("command output is not a JSON object")
    return value


def parse_request(raw: str) -> tuple[int, bool]:
    try:
        value = json.loads(raw)
    except json.JSONDecodeError as exc:
        fail(f"request is not valid JSON: {exc}")
    if not isinstance(value, dict) or set(value) != {"issue", "publication_authorized"}:
        fail("request fields do not match the operation contract")
    issue = value["issue"]
    if isinstance(issue, str) and issue.isdigit():
        issue = int(issue)
    authorized = value["publication_authorized"]
    if isinstance(authorized, str) and authorized in {"true", "false"}:
        authorized = authorized == "true"
    if type(issue) is not int or issue < 1 or type(authorized) is not bool:
        fail("request is invalid")
    return issue, authorized


def main() -> int:
    if len(sys.argv) != 3 or sys.argv[1] != "run":
        fail("expected the run operation and one JSON request")
    issue, authorized = parse_request(sys.argv[2])
    root_result = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=False,
    )
    if root_result.returncode:
        fail(root_result.stderr.strip() or "run from an application Git root")
    root = Path(root_result.stdout.strip()).resolve()
    if Path.cwd().resolve() != root:
        fail("run from the application Git root")

    request = json.dumps({"issue": issue, "publication_authorized": authorized})
    result = run_json(str(HERE / "acme-rebase-git-stack"), "rebase", request, cwd=root)
    if result.get("status") != "stack-republish-required" or not authorized:
        write_json(result)
        return 0

    run_json(
        str(HERE / "acme-republish-rebased-git-stack"), "republish",
        json.dumps({"issue": issue, "publication_authorized": True}), cwd=root,
    )
    final_report = run_json(
        str(HERE / "acme-report-github-issue-workflow"), "report", "--issue", str(issue), cwd=root,
    )
    write_json(final_report)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
