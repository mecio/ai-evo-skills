#!/usr/bin/env python3
"""Resume a workflow by applying only the recovery action requested by its report."""

from __future__ import annotations

import json
import subprocess
import sys
from pathlib import Path

from lib.acme_script_common import fail, write_json


HERE = Path(__file__).resolve().parent


def run(*args: str) -> dict:
    result = subprocess.run(args, capture_output=True, text=True, check=False)
    if result.returncode:
        fail(result.stderr.strip() or result.stdout.strip() or "workflow recovery command failed")
    try:
        output = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        fail(f"workflow report is not valid JSON: {exc}")
    if not isinstance(output, dict):
        fail("workflow report is not a JSON object")
    return output


def request(raw: str) -> tuple[int, bool]:
    try:
        value = json.loads(raw)
    except json.JSONDecodeError as exc:
        fail(f"request is not valid JSON: {exc}")
    if not isinstance(value, dict) or set(value) != {"issue", "publication_authorized"}:
        fail("request fields do not match the operation contract")
    issue = value["issue"]
    if isinstance(issue, str) and issue.isdigit():
        issue = int(issue)
    if type(issue) is not int or issue < 1 or type(value["publication_authorized"]) is not bool:
        fail("request is invalid")
    return issue, value["publication_authorized"]


def main() -> int:
    if len(sys.argv) != 3 or sys.argv[1] != "resume":
        fail("expected the resume operation and one JSON request")
    issue, authorized = request(sys.argv[2])
    report = run(str(HERE / "acme-report-github-issue-workflow"), "report", "--issue", str(issue))
    if report.get("status") == "branch-recovery-required":
        run(str(HERE / "acme-git-recipe-branch"), "prepare", json.dumps({"issue": issue, "worklog_session": "", "branch": ""}))
        report = run(str(HERE / "acme-report-github-issue-workflow"), "report", "--issue", str(issue))
    if report.get("status") == "stack-republish-required" and authorized:
        run(str(HERE / "acme-republish-rebased-git-stack"), "republish", json.dumps({"issue": issue, "publication_authorized": True}))
        report = run(str(HERE / "acme-report-github-issue-workflow"), "report", "--issue", str(issue))
    write_json(report)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
