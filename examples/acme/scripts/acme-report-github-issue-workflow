#!/usr/bin/env python3
"""Report the resumable state and next recipe for a GitHub issue workflow."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import subprocess
import tempfile
from pathlib import Path
from typing import Any, NoReturn

from acme_worklog_paths import layer_session_name
from lib.acme_worklog_recovery import order_layers, published_layers, registered_branch


SESSION_RE = re.compile(r"^(?P<phase>0[0-8])-(?P<action>[a-z0-9-]+)-attempt-(?P<attempt>[0-9]+)$")
LAYER_RE = re.compile(r"^[Ll][0-9]+$")
RECIPE_ROOT = Path(__file__).resolve().parents[1] / "skills" / "catalog" / "recipes"

NEW_WORKFLOW_RECIPES = {
    "acme-recipe-01-refine-github-issue": ("01", "refine"),
    "acme-recipe-02-analyze-github-issue-code": ("02", "analyze"),
}


def fail(message: str) -> NoReturn:
    raise SystemExit(f"error: {message}")


def find_workspace(start: Path) -> Path:
    for candidate in (start.resolve(), *start.resolve().parents):
        marker = candidate / ".ai-evo"
        if marker.is_dir() or marker.is_symlink():
            return candidate
    fail("cannot find a .ai-evo directory or symlink in the current path or its parents")


def parse_issue(value: str) -> int:
    match = re.fullmatch(r"#?([1-9][0-9]*)", value.strip())
    if not match:
        fail("issue must be a positive number, with an optional # prefix")
    return int(match.group(1))


def pending_creation_sessions(workspace: Path, issue: int) -> list[dict[str, Any]]:
    """Find completed recipe 00 sessions that recorded creation of ``issue``."""
    root = workspace / ".ai-evo-work" / "issue-pending"
    found: list[dict[str, Any]] = []
    if not root.is_dir():
        return found
    for path in root.glob("attempt-*/00-design-attempt-*/session.json"):
        session = read_json(path)
        if (session.get("recipe_name") != "acme-recipe-00-design-github-issue"
                or session.get("status") != "completed"):
            continue
        entries = session.get("entries")
        if not isinstance(entries, list):
            continue
        for entry in reversed(entries):
            if not isinstance(entry, dict) or entry.get("step_name") != "create_issue":
                continue
            filename = entry.get("file")
            if not isinstance(filename, str):
                continue
            record = read_json(path.parent / filename)
            if record.get("outcome") != "succeeded" or not isinstance(record.get("output"), str):
                continue
            try:
                output = json.loads(record["output"])
            except json.JSONDecodeError:
                continue
            if output.get("number") == issue:
                found.append({"path": path.parent, "session": session})
            break
    return found


def creation_checkpoint(session_dir: Path, session: dict[str, Any], issue: int) -> dict[str, Any] | None:
    """Return the successful create_issue record when it created ``issue``."""
    if (session.get("recipe_name") != "acme-recipe-00-design-github-issue"
            or session.get("status") != "completed"):
        return None
    entries = session.get("entries")
    if not isinstance(entries, list):
        return None
    for entry in reversed(entries):
        if not isinstance(entry, dict) or entry.get("step_name") != "create_issue":
            continue
        filename = entry.get("file")
        if not isinstance(filename, str):
            return None
        record = read_json(session_dir / filename)
        if record.get("outcome") != "succeeded" or not isinstance(record.get("output"), str):
            return None
        try:
            output = json.loads(record["output"])
        except json.JSONDecodeError:
            return None
        return record if isinstance(output, dict) and output.get("number") == issue else None
    return None


def atomic_write(path: Path, content: bytes) -> None:
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        if temporary.exists():
            temporary.unlink()


def render_json(value: dict[str, Any]) -> bytes:
    return (json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\n").encode("utf-8")


def replace_session_references(value: Any, old_name: str, new_name: str) -> Any:
    """Update metadata coordinates, deliberately leaving checkpoint outputs immutable."""
    if isinstance(value, dict):
        return {
            key: value[key] if key in {"output", "output_sha256"}
            else replace_session_references(value[key], old_name, new_name)
            for key in value
        }
    if isinstance(value, list):
        return [replace_session_references(item, old_name, new_name) for item in value]
    return new_name if value == old_name else value


def refresh_entry_digests(session_dir: Path, session: dict[str, Any]) -> None:
    entries = session.get("entries")
    if not isinstance(entries, list):
        return
    for entry in entries:
        if not isinstance(entry, dict):
            continue
        filename = entry.get("file")
        if isinstance(filename, str):
            record = session_dir / filename
            if record.is_file():
                entry["sha256"] = hashlib.sha256(record.read_bytes()).hexdigest()


def normalize_moved_creation(session_dir: Path, issue: int) -> dict[str, Any]:
    """Normalize a moved recipe 00 in place without changing any checkpoint output."""
    session_path = session_dir / "session.json"
    session = read_json(session_path)
    old_name = session.get("session_name")
    new_name = f"issue-{issue}/attempt-01/{session_dir.name}"
    if not isinstance(old_name, str):
        fail(f"session has no valid name: {session_path}")
    if old_name == new_name and session.get("session_slug") == new_name:
        return session
    if session.get("recipe_name") != "acme-recipe-00-design-github-issue":
        fail(f"not a recipe 00 session: {session_path}")
    normalized = replace_session_references(session, old_name, new_name)
    assert isinstance(normalized, dict)
    normalized["session_name"] = new_name
    normalized["session_slug"] = new_name
    normalized["previous_session_name"] = old_name
    record_updates: list[tuple[Path, dict[str, Any]]] = []
    for record_path in sorted(session_dir.glob("*.json")):
        if record_path.name == "session.json":
            continue
        record = read_json(record_path)
        updated = replace_session_references(record, old_name, new_name)
        if isinstance(updated, dict) and updated != record:
            record_updates.append((record_path, updated))
    # All validation is complete before a file is changed.  Checkpoint outputs and
    # their digest are explicitly excluded from replacement above.
    for record_path, record in record_updates:
        atomic_write(record_path, render_json(record))
    refresh_entry_digests(session_dir, normalized)
    atomic_write(session_path, render_json(normalized))
    context = session_dir / "context.md"
    if context.is_file():
        atomic_write(context, context.read_text(encoding="utf-8").replace(old_name, new_name).encode("utf-8"))
    return normalized


def moved_creation_sessions(workspace: Path, issue: int) -> list[dict[str, Any]]:
    """Find recipe 00 creation sessions already under the issue root, including legacy metadata."""
    root = workspace / ".ai-evo-work" / f"issue-{issue}" / "attempt-01"
    found: list[dict[str, Any]] = []
    if not root.is_dir():
        return found
    for path in root.glob("00-design-attempt-*/session.json"):
        session = read_json(path)
        if creation_checkpoint(path.parent, session, issue) is not None:
            found.append({"path": path.parent, "session": session})
    return found


def promote_pending_creation(workspace: Path, issue: int, creation: dict[str, Any]) -> dict[str, Any]:
    """Atomically move one verified pending recipe 00 to its canonical issue path."""
    source = creation["path"]
    session = creation["session"]
    if not isinstance(source, Path) or creation_checkpoint(source, session, issue) is None:
        fail("la sessione 00 pending non è completa o non contiene il checkpoint create_issue richiesto")
    destination = workspace / ".ai-evo-work" / f"issue-{issue}" / "attempt-01" / source.name
    if destination.exists():
        existing = read_json(destination / "session.json") if (destination / "session.json").is_file() else {}
        source_checkpoint = creation_checkpoint(source, session, issue)
        destination_checkpoint = creation_checkpoint(destination, existing, issue)
        if (destination_checkpoint is None or source_checkpoint is None
                or destination_checkpoint.get("output") != source_checkpoint.get("output")):
            fail(f"la destinazione esiste con una sessione 00 diversa: {destination}")
        return {"path": destination, "session": existing}
    if source.is_symlink() or any(parent.is_symlink() for parent in source.parents if parent != workspace.parent):
        fail("la sessione pending o uno dei suoi genitori non può essere un collegamento simbolico")
    destination.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    if source.stat().st_dev != destination.parent.stat().st_dev:
        fail("la promozione richiede source e destinazione sullo stesso filesystem")
    # Normalize before the single directory rename.  No checkpoint output changes;
    # should the rename fail, the original directory is still present and valid.
    normalize_moved_creation(source, issue)
    try:
        os.rename(source, destination)
    except OSError as exc:
        fail(f"impossibile spostare atomicamente la sessione pending: {exc}")
    pending_attempt = source.parent
    pending_root = pending_attempt.parent
    if pending_attempt.is_dir() and not any(pending_attempt.iterdir()):
        pending_attempt.rmdir()
    if pending_root.is_dir() and not any(pending_root.iterdir()):
        pending_root.rmdir()
    return {"path": destination, "session": read_json(destination / "session.json")}


def read_json(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        fail(f"cannot read {path}: {exc}")
    if not isinstance(value, dict):
        fail(f"{path} must contain a JSON object")
    return value


def sessions(issue_root: Path) -> list[dict[str, Any]]:
    found: list[dict[str, Any]] = []
    for path in issue_root.glob("attempt-*/**/session.json"):
        relative = path.parent.relative_to(issue_root)
        parts = relative.parts
        if not parts or not re.fullmatch(r"attempt-[0-9]+", parts[0]):
            continue
        layer_id = None
        session_part = parts[1] if len(parts) == 2 else None
        if len(parts) == 4 and parts[1] == "layers" and LAYER_RE.fullmatch(parts[2]):
            layer_id = parts[2].upper()
            session_part = parts[3]
        match = SESSION_RE.fullmatch(session_part or "")
        if not match:
            continue
        session = read_json(path)
        if session.get("session_slug") != str(path.parent.relative_to(issue_root.parent)):
            # The worklog might be copied elsewhere. The canonical directory name remains authoritative.
            session_name = session.get("session_name")
            if not isinstance(session_name, str):
                fail(f"session has no valid name: {path}")
        found.append({
            "path": path.parent,
            "session": session,
            "workflow_attempt": int(parts[0].removeprefix("attempt-")),
            "phase": match.group("phase"),
            "action": match.group("action"),
            "phase_attempt": int(match.group("attempt")),
            "layer_id": layer_id,
        })
    return found


def latest_workflow(sessions_for_issue: list[dict[str, Any]]) -> list[dict[str, Any]]:
    if not sessions_for_issue:
        return []
    attempt = max(item["workflow_attempt"] for item in sessions_for_issue)
    return [item for item in sessions_for_issue if item["workflow_attempt"] == attempt]


def latest_phase(workflow: list[dict[str, Any]]) -> dict[str, Any]:
    # A completed correction supersedes the paused implementation checkpoint even
    # when both are their first attempt under phase 04.
    return max(workflow, key=lambda item: (item["phase"], item["phase_attempt"],
                                           item.get("action") == "correction"))


def workflow_attempts(sessions_for_issue: list[dict[str, Any]]) -> list[int]:
    return sorted({item["workflow_attempt"] for item in sessions_for_issue})


def artifact(session_dir: Path, pattern: str) -> str | None:
    matches = sorted(session_dir.glob(pattern))
    return str(matches[0]) if len(matches) == 1 else None


def next_session(issue: int, workflow_attempt: int, phase: str, action: str,
                 phase_attempt: int = 1) -> str:
    return f"issue-{issue}/attempt-{workflow_attempt:02d}/{phase}-{action}-attempt-{phase_attempt:02d}"


def declared_recipe_inputs(recipe: str) -> set[str]:
    """Read the compact recipe input block without adding a YAML runtime dependency."""
    path = RECIPE_ROOT / recipe / "recipe.yaml"
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        fail(f"cannot read recipe input contract for {recipe}: {exc}")
    inputs: set[str] = set()
    inside = False
    for line in lines:
        if line == "inputs:":
            inside = True
            continue
        if inside and line and not line.startswith(" "):
            break
        if inside:
            match = re.fullmatch(r"  ([a-z][a-z0-9_]*):.*", line)
            if match:
                inputs.add(match.group(1))
    if not inputs:
        fail(f"recipe {recipe} has no readable inputs block")
    return inputs


def require_declared_recipe_inputs(recipe: str, inputs: dict[str, str]) -> None:
    unknown = sorted(set(inputs) - declared_recipe_inputs(recipe))
    if unknown:
        fail(f"report returns undeclared inputs for {recipe}: {', '.join(unknown)}")


CORRECTION_RECIPE = "acme-recipe-04-implement-github-issue-correction"


def successful_step_output(session: dict[str, Any], step_name: str) -> dict[str, Any] | None:
    """Read the immutable JSON output of the last successful named checkpoint."""
    entries = session["session"].get("entries")
    if not isinstance(entries, list):
        return None
    for entry in reversed(entries):
        if not isinstance(entry, dict) or entry.get("step_name") != step_name or entry.get("outcome") != "succeeded":
            continue
        filename = entry.get("file")
        if not isinstance(filename, str):
            return None
        try:
            record = read_json(session["path"] / filename)
            output = record.get("output")
            if isinstance(output, str):
                output = json.loads(output)
        except (OSError, UnicodeError, json.JSONDecodeError):
            return None
        return output if isinstance(output, dict) else None
    return None


def has_successful_step(session: dict[str, Any], step_name: str) -> bool:
    """Validate an immutable successful checkpoint whose output may be non-JSON."""
    entries = session["session"].get("entries")
    if not isinstance(entries, list):
        return False
    for entry in reversed(entries):
        if not isinstance(entry, dict) or entry.get("step_name") != step_name or entry.get("outcome") != "succeeded":
            continue
        filename, expected = entry.get("file"), entry.get("output_sha256")
        if not isinstance(filename, str) or not isinstance(expected, str):
            return False
        try:
            record = read_json(session["path"] / filename)
        except (OSError, UnicodeError, json.JSONDecodeError):
            return False
        output = record.get("output")
        return isinstance(output, str) and hashlib.sha256(output.encode("utf-8")).hexdigest() == expected
    return False


def report_input(session: dict[str, Any], name: str) -> str | None:
    value = session["session"].get("session_input")
    return value.get(name) if isinstance(value, dict) and isinstance(value.get(name), str) else None


def verification_from_lineage(current: dict[str, Any], workflow: list[dict[str, Any]]) -> str | None:
    """Find the immutable 05/06 verification behind a publication session."""
    by_name = {item["session"].get("session_name"): item for item in workflow
               if isinstance(item["session"].get("session_name"), str)}
    candidate = current
    seen: set[str] = set()
    while candidate:
        name = candidate["session"].get("session_name")
        if not isinstance(name, str) or name in seen:
            return None
        seen.add(name)
        session_input = candidate["session"].get("session_input")
        previous = session_input.get("previous_session") if isinstance(session_input, dict) else None
        candidate = by_name.get(previous) if isinstance(previous, str) else None
        if candidate is None:
            return None
        step = "verify_layer" if candidate["phase"] == "05" else "verify_epic" if candidate["phase"] == "06" else None
        verification = successful_step_output(candidate, step) if step else None
        if verification is not None:
            return json.dumps(verification, ensure_ascii=False, sort_keys=True)
    return None


def review_state(workspace: Path, verification: dict[str, Any]) -> tuple[str, str, str, list[str]]:
    commit, state = verification.get("commit"), verification.get("stack_state")
    if not isinstance(commit, dict) or not isinstance(state, dict):
        return "invalid", "", "", []
    oid, branch = commit.get("oid"), state.get("current_branch")
    if not isinstance(oid, str) or not isinstance(branch, str) or not local_branch_exists(workspace, branch):
        return "invalid", "", "", []
    head = subprocess.run(["git", "-C", str(workspace), "rev-parse", branch], capture_output=True, text=True, check=False)
    if head.returncode or not head.stdout.strip():
        return "invalid", branch, oid, []
    current = head.stdout.strip()
    if current == oid:
        return "current", branch, current, []
    if subprocess.run(["git", "-C", str(workspace), "merge-base", "--is-ancestor", oid, current], check=False).returncode:
        return "rewritten", branch, current, []
    commits = subprocess.run(["git", "-C", str(workspace), "log", "--format=%H %s", f"{oid}..{current}"], capture_output=True, text=True, check=False)
    return "advanced", branch, current, commits.stdout.splitlines() if not commits.returncode else []


def inherited_implementation_instructions(current: dict[str, Any], workflow: list[dict[str, Any]]) -> str:
    """Recover the original implementation constraints through immutable session lineage."""
    by_name = {item["session"].get("session_name"): item for item in workflow
               if isinstance(item["session"].get("session_name"), str)}
    candidate = current
    seen: set[str] = set()
    while candidate:
        name = candidate["session"].get("session_name")
        if not isinstance(name, str) or name in seen:
            return ""
        seen.add(name)
        session_input = candidate["session"].get("session_input")
        if not isinstance(session_input, dict):
            return ""
        instructions = session_input.get("implementation_instructions")
        if isinstance(instructions, str) and instructions:
            return instructions
        if candidate["phase"] == "04":
            instructions = session_input.get("developer_instructions")
            return instructions if isinstance(instructions, str) else ""
        previous = session_input.get("previous_session")
        candidate = by_name.get(previous) if isinstance(previous, str) else None
    return ""


def repeat_review(issue: int, current: dict[str, Any], verification: dict[str, Any], branch: str, head: str,
                  commits: list[str], workflow: list[dict[str, Any]]) -> dict[str, Any]:
    state = verification["stack_state"]
    branches = state.get("branches", []) if isinstance(state, dict) else []
    entry = next((item for item in branches if isinstance(item, dict) and item.get("name") == branch), {})
    parent = entry.get("parent", "") if isinstance(entry, dict) else ""
    trunk = state.get("trunk", "") if isinstance(state, dict) else ""
    sequence = next((index for index, item in enumerate(branches) if isinstance(item, dict) and item.get("name") == branch), 0)
    previous_inputs = current["session"].get("session_input")
    instructions = inherited_implementation_instructions(current, workflow)
    inputs = {"issue": str(issue), "branch": branch, "base": parent,
              "review_artifact_name": f"issue-{issue}-review.md",
              "stack_layer": json.dumps({"base_branch": trunk, "parent_branch": parent, "branch": branch, "sequence": sequence}, ensure_ascii=False, sort_keys=True),
              "implementation_instructions": instructions}
    if isinstance(previous_inputs, dict):
        work_specification = previous_inputs.get("work_specification")
        if isinstance(work_specification, str):
            inputs["work_specification"] = work_specification
    previous_review = artifact(current["path"], f"issue-{issue}-review.md")
    if previous_review:
        inputs["previous_review"] = previous_review
    return recommendation(issue, current, "acme-recipe-05-review-github-issue",
        next_session(issue, current["workflow_attempt"], "05", "review", current["phase_attempt"] + 1),
        inputs, [],
        f"Il branch è avanzato da {verification['commit']['oid']} a {head}; ripetere la review. Commit non revisionati: {'; '.join(commits) or 'nessun dettaglio disponibile'}.")


def propose_push(issue: int, current: dict[str, Any], verification: dict[str, Any]) -> dict[str, Any]:
    return recommendation(issue, current, "acme-recipe-07-push-github-stack",
        next_session(issue, current["workflow_attempt"], "07", "push"),
        {"issue": str(issue), "verification_report": json.dumps(verification, ensure_ascii=False, sort_keys=True)},
        ["publication_authorized"],
        "La recipe 07 pubblica sul remote lo stack verificato; richiede una conferma esplicita per il push.")


def propose_submit(issue: int, current: dict[str, Any], publication: dict[str, Any], verification_report: str) -> dict[str, Any]:
    return recommendation(issue, current, "acme-recipe-08-submit-github-stack",
        next_session(issue, current["workflow_attempt"], "08", "submit"),
        {"issue": str(issue), "publication_report": json.dumps(publication, ensure_ascii=False, sort_keys=True),
         "verification_report": verification_report}, ["submit_authorized"],
        "La recipe 08 crea o aggiorna pull request remote; richiede una conferma esplicita per il submit.")


def has_unpublished_correction_checkpoint(session: dict[str, Any]) -> bool:
    """A correction path is valid only immediately after its local implementation checkpoint."""
    entries = session["session"].get("entries")
    if not isinstance(entries, list) or not entries:
        return False
    expected = "correct_implementation" if session.get("action") == "correction" else "implement_issue"
    last = entries[-1]
    if not isinstance(last, dict) or last.get("step_name") != expected or last.get("outcome") != "succeeded":
        return False
    return not any(isinstance(entry, dict) and entry.get("step_name") == "publish_branch" for entry in entries)


def correction_session_name(issue: int, current: dict[str, Any]) -> str:
    """Create the next independent phase-04 correction session beside its source."""
    parent = current["path"].parent
    attempts = []
    for candidate in parent.glob("04-correction-attempt-*/session.json"):
        match = SESSION_RE.fullmatch(candidate.parent.name)
        if match:
            attempts.append(int(match.group("attempt")))
    source_name = current["session"]["session_name"]
    prefix = source_name.rsplit("/", 1)[0]
    return f"{prefix}/04-correction-attempt-{max(attempts, default=0) + 1:02d}"


def new_breakdown_attempt(issue: int, current_workflow: list[dict[str, Any]], all_sessions: list[dict[str, Any]],
                          reason: str) -> dict[str, Any]:
    """Open a new 03 attempt while retaining an immutable analysis from the current one."""
    current = latest_phase(current_workflow)
    unfinished = [item for item in current_workflow if item["session"].get("status") != "completed"]
    if unfinished:
        return blocked(issue, current, "L'attempt corrente contiene sessioni attive o fallite da recuperare prima di aprirne uno nuovo.")
    breakdowns = [item for item in current_workflow if item["phase"] == "03" and item["layer_id"] is None]
    for breakdown_session in breakdowns:
        path = artifact(breakdown_session["path"], f"issue-{issue}-breakdown.json")
        if not path:
            continue
        breakdown = read_json(Path(path))
        if breakdown.get("mode") == "epic" and isinstance(breakdown.get("sub_issues"), list) and breakdown["sub_issues"]:
            return blocked(issue, current, "L'attempt corrente ha creato sub-issue dell'epic: non è sicuro invalidarne gli effetti remoti.")
    analyses = [item for item in current_workflow if item["phase"] == "02" and item["layer_id"] is None
                and item["session"].get("status") == "completed"]
    ready: list[tuple[dict[str, Any], str]] = []
    for analysis_session in analyses:
        path = artifact(analysis_session["path"], f"issue-{issue}-analysis.json")
        if path:
            ready.append((analysis_session, path))
    if not ready:
        return blocked(issue, current, "Manca una fase 02 conclusa con l'artefatto di analisi nell'attempt corrente.")
    analysis_session, analysis_path = max(ready, key=lambda item: item[0]["phase_attempt"])
    next_attempt = max(workflow_attempts(all_sessions)) + 1
    name = next_session(issue, next_attempt, "03", "breakdown")
    inputs = {"issue_analysis": analysis_path, "worklog_session_name": name,
              "worklog_session_input": json.dumps({
                  "issue": str(issue), "analysis_session": analysis_session["session"]["session_name"],
                  "previous_workflow_attempt": current["workflow_attempt"], "reason": reason,
              }, ensure_ascii=False, sort_keys=True)}
    require_declared_recipe_inputs("acme-recipe-03-breakdown-github-issue", inputs)
    invocation = " ".join(["$acme-recipe-03-breakdown-github-issue"] +
                          [f"{key}={json.dumps(value, ensure_ascii=False)}" for key, value in inputs.items()])
    return {"schema_version": 1, "status": "ready", "issue": issue,
            "current_session": current["session"]["session_name"],
            "recommended_recipe": "acme-recipe-03-breakdown-github-issue",
            "worklog_session_name": name, "resolved_inputs": inputs, "missing_inputs": [],
            "suggested_invocation": invocation,
            "reason": "Si apre un nuovo attempt di scomposizione con l'analisi conclusa dell'attempt precedente."}


def implementation_evidence(workspace: Path, issue: int, trunk: str) -> tuple[str | None, str | None]:
    try:
        repository = subprocess.run(
            ["git", "-C", str(workspace), "rev-parse", "--is-inside-work-tree"],
            capture_output=True, text=True, check=False,
        )
    except OSError as exc:
        return None, f"Impossibile verificare il repository Git locale: {exc}."
    if repository.returncode != 0 or repository.stdout.strip() != "true":
        return None, "La worktree non è un repository Git: non è sicuro suggerire una nuova implementazione."
    branches = subprocess.run(
        ["git", "-C", str(workspace), "for-each-ref", "--format=%(refname:short)", "refs/heads"],
        capture_output=True, text=True, check=False,
    )
    if branches.returncode != 0:
        return None, "Impossibile leggere i branch locali: non è sicuro suggerire una nuova implementazione."
    marker = f"#{issue}_"
    for branch in (line for line in branches.stdout.splitlines() if marker in line):
        commits = subprocess.run(
            ["git", "-C", str(workspace), "log", "--format=%H%x00%s", trunk + ".." + branch],
            capture_output=True, text=True, check=False,
        )
        if commits.returncode != 0:
            return None, f"Impossibile confrontare i commit locali con {trunk}: non è sicuro suggerire una nuova implementazione."
        for line in commits.stdout.splitlines():
            sha, separator, subject = line.partition("\x00")
            if separator and subject.startswith(f"#{issue} "):
                return (branch, f"{sha} {subject}"), None
    return None, None


def issue_branches(workspace: Path, issue: int) -> list[str]:
    """Return all local issue branches; stacked callers filter already-recorded layers."""
    branches = subprocess.run(["git", "-C", str(workspace), "for-each-ref", "--format=%(refname:short)", "refs/heads"],
                              capture_output=True, text=True, check=False)
    if branches.returncode:
        return []
    found: list[str] = []
    for branch in branches.stdout.splitlines():
        if f"#{issue}_" not in branch:
            continue
        commits = subprocess.run(["git", "-C", str(workspace), "log", "--format=%s", branch],
                                 capture_output=True, text=True, check=False)
        if any(subject.startswith(f"#{issue} ") for subject in commits.stdout.splitlines()):
            found.append(branch)
    return found


def implementation_stack_layer(workspace: Path, issue: int, expected_branch: str | None = None) -> tuple[dict[str, Any] | None, str | None, list[str]]:
    """Find the gh-stack layer that contains the implementation commits for an issue."""
    try:
        metadata = subprocess.run(
            ["git", "-C", str(workspace), "rev-parse", "--git-path", "gh-stack"],
            capture_output=True, text=True, check=False,
        )
    except OSError as exc:
        return None, f"Impossibile leggere i metadati dello stack locale: {exc}.", []
    if metadata.returncode:
        return None, "Impossibile localizzare i metadati dello stack locale.", []
    metadata_path = Path(metadata.stdout.strip())
    if not metadata_path.is_absolute():
        metadata_path = workspace / metadata_path
    try:
        document = json.loads(metadata_path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        return None, f"Impossibile leggere lo stack locale: {exc}.", []
    stacks = document.get("stacks")
    if not isinstance(stacks, list):
        return None, "I metadati dello stack locale non contengono una lista di stack.", []
    matches: list[dict[str, Any]] = []
    warnings: list[str] = []
    configured_trunk, _, _ = trunk_branch(workspace)

    def local_branch_exists(branch: str) -> bool:
        verification = subprocess.run(
            ["git", "-C", str(workspace), "rev-parse", "--verify", "--quiet", f"refs/heads/{branch}"],
            capture_output=True, text=True, check=False,
        )
        return verification.returncode == 0

    for stack in stacks:
        if not isinstance(stack, dict):
            continue
        trunk = stack.get("trunk", {}).get("branch") if isinstance(stack.get("trunk"), dict) else None
        branches = stack.get("branches")
        if not isinstance(trunk, str) or not trunk or not isinstance(branches, list):
            continue
        if configured_trunk and trunk != configured_trunk:
            warnings.append(f"Stack dichiara il trunk {trunk}, diverso dal trunk configurato {configured_trunk}.")
        if not local_branch_exists(trunk):
            warnings.append(f"Stack ignorato: il trunk locale {trunk} non esiste.")
            continue
        parent = trunk
        for sequence, entry in enumerate(branches):
            branch = entry.get("branch") if isinstance(entry, dict) else None
            if not isinstance(branch, str) or not branch:
                warnings.append("Stack ignorato: contiene un layer senza un branch valido.")
                break
            missing = [name for name in (parent, branch) if not local_branch_exists(name)]
            if missing:
                warnings.append(
                    f"Stack ignorato dal layer {branch}: manca il branch locale {missing[0]}."
                )
                break
            commits = subprocess.run(
                ["git", "-C", str(workspace), "log", "--format=%s", f"{parent}..{branch}"],
                capture_output=True, text=True, check=False,
            )
            if commits.returncode:
                warnings.append(f"Stack ignorato dal layer {branch}: impossibile leggere i commit.")
                break
            if expected_branch == branch or (expected_branch is None and any(subject.startswith(f"#{issue} ") for subject in commits.stdout.splitlines())):
                matches.append({
                    "base_branch": trunk,
                    "parent_branch": parent,
                    "branch": branch,
                    "sequence": sequence,
                })
            parent = branch
    if len(matches) == 1:
        return matches[0], None, warnings
    if not matches:
        if expected_branch:
            return None, f"Il branch atteso {expected_branch} non è un layer leggibile dello stack locale.", warnings
        return None, "Nessun layer dello stack locale contiene commit dell'issue.", warnings
    return None, "Più layer dello stack locale contengono commit dell'issue; selezionare il layer manualmente.", warnings


def legacy_child_stack_layer(workspace: Path, issue: int, parent_branch: str) -> tuple[dict[str, Any] | None, str | None, list[str]]:
    """Find the single direct stacked child of a recorded parent for a legacy 04 checkpoint."""
    try:
        metadata = subprocess.run(["git", "-C", str(workspace), "rev-parse", "--git-path", "gh-stack"],
                                  capture_output=True, text=True, check=False)
    except OSError as exc:
        return None, f"Impossibile leggere i metadati dello stack locale: {exc}.", []
    if metadata.returncode:
        return None, "Impossibile localizzare i metadati dello stack locale.", []
    metadata_path = Path(metadata.stdout.strip())
    if not metadata_path.is_absolute():
        metadata_path = workspace / metadata_path
    try:
        document = json.loads(metadata_path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        return None, f"Impossibile leggere lo stack locale: {exc}.", []
    candidates: list[dict[str, Any]] = []
    for stack in document.get("stacks", []):
        if not isinstance(stack, dict):
            continue
        trunk = stack.get("trunk", {}).get("branch") if isinstance(stack.get("trunk"), dict) else None
        branches = stack.get("branches")
        if not isinstance(trunk, str) or not isinstance(branches, list):
            continue
        parent = trunk
        for sequence, entry in enumerate(branches):
            branch = entry.get("branch") if isinstance(entry, dict) else None
            if not isinstance(branch, str):
                break
            if parent == parent_branch and branch_has_issue_commit(workspace, issue, branch, parent):
                candidates.append({"base_branch": trunk, "parent_branch": parent, "branch": branch, "sequence": sequence})
            parent = branch
    if len(candidates) == 1:
        return candidates[0], None, [
            f"Checkpoint 04 legacy senza output JSON: individuato il figlio diretto {candidates[0]['branch']} del parent {parent_branch}."
        ]
    if not candidates:
        return None, f"Il checkpoint 04 legacy non ha un figlio diretto univoco con commit dell'issue dal parent {parent_branch}.", []
    return None, f"Il checkpoint 04 legacy ha più figli diretti con commit dell'issue dal parent {parent_branch}; selezionare il layer manualmente.", []


def recorded_branch(session: dict[str, Any] | None) -> str | None:
    """Get the immutable branch coordinate from a layer checkpoint."""
    if session is None:
        return None
    input_value = session["session"].get("session_input")
    if isinstance(input_value, dict) and isinstance(input_value.get("branch"), str):
        return input_value["branch"]
    for record in sorted(session["path"].glob("[0-9]*.json"), reverse=True):
        try:
            value = read_json(record)
            output = value.get("output")
            if isinstance(output, str):
                output = json.loads(output)
            if isinstance(output, dict) and isinstance(output.get("branch"), str):
                return output["branch"]
        except (json.JSONDecodeError, OSError, UnicodeError):
            continue
    return None


def branch_has_issue_commit(workspace: Path, issue: int, branch: str, parent: str | None = None) -> bool:
    revision = f"{parent}..{branch}" if parent else branch
    result = subprocess.run(["git", "-C", str(workspace), "log", "--format=%s", revision],
                            capture_output=True, text=True, check=False)
    return result.returncode == 0 and any(subject.startswith(f"#{issue} ") for subject in result.stdout.splitlines())


def current_branch(workspace: Path) -> str | None:
    result = subprocess.run(["git", "-C", str(workspace), "branch", "--show-current"],
                            capture_output=True, text=True, check=False)
    branch = result.stdout.strip()
    return branch if result.returncode == 0 and branch else None


def local_branch_exists(workspace: Path, branch: str) -> bool:
    return subprocess.run(
        ["git", "-C", str(workspace), "show-ref", "--verify", "--quiet", f"refs/heads/{branch}"],
        capture_output=True, text=True, check=False,
    ).returncode == 0


def correction_recommendation(issue: int, source: dict[str, Any], workspace: Path,
                              correction_instructions: str, layer: dict[str, Any] | None = None) -> dict[str, Any]:
    """Resolve an independent correction only from a successful 04 checkpoint."""
    step_name = "correct_implementation" if source.get("action") == "correction" else "implement_issue"
    implementation = successful_step_output(source, step_name)
    if implementation is None:
        return blocked(issue, source, f"Il checkpoint {step_name} della recipe 04 non contiene un output JSON riutilizzabile.")
    branch = implementation.get("branch")
    parent = implementation.get("parent_branch")
    if not isinstance(branch, str) or not branch or not isinstance(parent, str) or not parent:
        return blocked(issue, source, "L'output registrato della recipe 04 non contiene branch e parent_branch validi.")
    if current_branch(workspace) != branch:
        return blocked(issue, source, f"Il branch corrente non corrisponde al branch registrato dalla recipe 04 ({branch}).")
    if not branch_has_issue_commit(workspace, issue, branch, parent):
        return blocked(issue, source, "Il branch registrato dalla recipe 04 non contiene i commit dell'issue rispetto al parent registrato.")
    session_name = correction_session_name(issue, source)
    combined = source["session"].get("session_input")
    original = combined.get("developer_instructions", "") if isinstance(combined, dict) else ""
    if not isinstance(original, str):
        original = ""
    instructions = "\n\n".join(item for item in (original, correction_instructions) if item)
    inputs = {
        "issue": str(issue), "branch": branch, "parent_branch": parent,
        "implementation_report": json.dumps(implementation, ensure_ascii=False, sort_keys=True),
        "developer_instructions": original,
    }
    if layer:
        inputs["layer"] = json.dumps(layer, ensure_ascii=False, sort_keys=True)
    if correction_instructions:
        inputs["correction_instructions"] = correction_instructions
    missing = [] if correction_instructions.strip() else ["correction_instructions"]
    return recommendation(
        issue, source, CORRECTION_RECIPE, session_name, inputs, missing,
        "Il checkpoint di implementazione è riuscito ma il branch non è ancora pubblicato: si apre una sessione di correzione separata.",
        {"implementation_session": source["session"]["session_name"], "branch": branch,
         "parent_branch": parent, "implementation_instructions": instructions,
         "correction_instructions": correction_instructions,
         **({"layer_id": layer["id"], "layer_sequence": layer["sequence"]} if layer else {})},
    )


def trunk_branch(workspace: Path) -> tuple[str | None, list[str], str | None]:
    """Resolve the configured worktree trunk, with a visible legacy fallback."""
    context_script = Path(__file__).with_name("acme-worktree-context")
    try:
        context = subprocess.run([str(context_script), "--root", str(workspace)],
                                 capture_output=True, text=True, check=False)
        data = json.loads(context.stdout) if context.returncode == 0 else None
    except (OSError, json.JSONDecodeError):
        data = None
    if isinstance(data, dict) and isinstance(data.get("trunk_branch"), str) and data["trunk_branch"]:
        trunk = data["trunk_branch"]
        result = subprocess.run(["git", "-C", str(workspace), "show-ref", "--verify", "--quiet",
                                 f"refs/heads/{trunk}"], check=False)
        if result.returncode != 0:
            return None, [], f"Il trunk configurato per il contesto {data.get('context', '')} ({trunk}) non esiste come branch locale."
        return trunk, [], None
    for candidate in ("master", "main"):
        result = subprocess.run(["git", "-C", str(workspace), "show-ref", "--verify", "--quiet", f"refs/heads/{candidate}"], check=False)
        if result.returncode == 0:
            return candidate, [f"Contesto worktree non risolvibile: usato il fallback legacy {candidate}."], None
    return "master", ["Contesto worktree non risolvibile: usato il fallback legacy master, che non esiste localmente."], None


def stacked_sessions(workflow: list[dict[str, Any]], layer_id: str, phase: str) -> list[dict[str, Any]]:
    return [item for item in workflow if item["layer_id"] == layer_id and item["phase"] == phase]


def latest_layer_session(workflow: list[dict[str, Any]], layer_id: str, phase: str) -> dict[str, Any] | None:
    matches = stacked_sessions(workflow, layer_id, phase)
    return max(matches, key=lambda item: (item["phase_attempt"], item.get("action") == "correction")) if matches else None


def layer_branch(workspace: Path, issue: int, workflow: list[dict[str, Any]], ordered: list[dict[str, Any]],
                 sequence: int) -> tuple[str | None, str | None, list[str]]:
    """Resolve a layer branch from its checkpoint, including a unique legacy child."""
    layer = ordered[sequence]
    implementation = latest_layer_session(workflow, str(layer["id"]).upper(), "04")
    if implementation is None:
        return None, f"Manca il checkpoint 04 del layer {layer['id']}.", []
    branch = recorded_branch(implementation)
    if branch:
        return branch, None, []
    if sequence == 0:
        return None, f"Il checkpoint 04 del layer {layer['id']} non registra il branch implementato.", []
    parent, problem, inherited_warnings = layer_branch(workspace, issue, workflow, ordered, sequence - 1)
    if problem or not parent:
        return None, problem, inherited_warnings
    recovered, problem, warnings = legacy_child_stack_layer(workspace, issue, parent)
    if problem:
        return None, problem, inherited_warnings + warnings
    assert recovered is not None
    return recovered["branch"], None, inherited_warnings + warnings


def stacked_recommendation(issue: int, current: dict[str, Any], recipe: str, session_name: str,
                           inputs: dict[str, str], layer: dict[str, Any], reason: str,
                           analysis_session: str | None = None, developer_instructions: str = "") -> dict[str, Any]:
    lineage = {"issue": str(issue), "layer_id": layer["id"], "layer_sequence": layer["sequence"],
               "breakdown_session": current["session"]["session_name"]}
    analysis = current["session"].get("session_input")
    if isinstance(analysis, dict) and isinstance(analysis.get("analysis_session"), str):
        lineage["analysis_session"] = analysis["analysis_session"]
    elif analysis_session:
        lineage["analysis_session"] = analysis_session
    if developer_instructions:
        lineage["developer_instructions"] = developer_instructions
        inputs["developer_instructions"] = developer_instructions
    return recommendation(issue, current, recipe, session_name, inputs, [], reason, lineage)


def retry_interrupted_stacked_review(issue: int, breakdown_session: dict[str, Any], review: dict[str, Any],
                                     workspace: Path, workflow: list[dict[str, Any]], layer: dict[str, Any],
                                     analysis: str | None) -> dict[str, Any] | None:
    """Open a fresh review after its saved review evidence could not be finalized."""
    if not has_successful_step(review, "verify_review"):
        return None
    previous_review = artifact(review["path"], f"issue-{issue}-review.md")
    if not previous_review:
        return None
    sequence = layer["sequence"]
    branch, problem, warnings = layer_branch(workspace, issue, workflow, [layer], 0) if sequence == 0 else (None, "", [])
    if sequence:
        # Use the complete ordered map through the caller for non-first layers.
        branch = recorded_branch(latest_layer_session(workflow, str(layer["id"]).upper(), "04"))
    if problem or not branch:
        return None
    stack, stack_problem, stack_warnings = implementation_stack_layer(workspace, issue, branch)
    if stack_problem or not stack:
        return None
    instructions = inherited_implementation_instructions(review, workflow)
    layer_id = str(layer["id"]).upper()
    lineage = {"layer_id": layer_id, "layer_sequence": layer["sequence"],
               "breakdown_session": breakdown_session["session"]["session_name"]}
    if analysis:
        lineage["analysis_session"] = analysis
    return recommendation(
        issue, review, "acme-recipe-05-review-github-issue",
        layer_session_name(issue, breakdown_session["workflow_attempt"], layer_id, "05", "review", review["phase_attempt"] + 1),
        {"issue": str(issue), "branch": stack["branch"], "base": stack["parent_branch"],
         "stack_layer": json.dumps(stack, ensure_ascii=False, sort_keys=True),
         "work_specification": json.dumps({**layer, "id": layer_id}, ensure_ascii=False, sort_keys=True),
         "review_artifact_name": f"issue-{issue}-review.md", "previous_review": previous_review,
         "implementation_instructions": instructions}, [],
        "La review precedente è stata salvata ma non finalizzata; ripeterla in una nuova sessione.", lineage)


def report_stacked(issue: int, breakdown_session: dict[str, Any], workflow: list[dict[str, Any]],
                   workspace: Path, breakdown: dict[str, Any], developer_instructions: str = "",
                   requested_recipe: str | None = None, correction_instructions: str = "") -> dict[str, Any]:
    layers = breakdown.get("layers", breakdown.get("items"))
    if not isinstance(layers, list) or len(layers) < 2:
        return blocked(issue, breakdown_session, "La scomposizione stacked non contiene almeno due layer validi.")
    ordered = sorted((item for item in layers if isinstance(item, dict)), key=lambda item: item.get("sequence", -1))
    publication_sessions = [item for item in workflow if item["layer_id"] is None and item["phase"] in {"07", "08"}]
    if publication_sessions:
        publication_current = max(publication_sessions, key=lambda item: (item["phase"], item["phase_attempt"]))
        if publication_current["session"].get("status") != "completed":
            return blocked(issue, publication_current, "La pubblicazione o il submit dello stack è attivo: recuperare prima la stessa sessione.")
        if publication_current["phase"] == "08":
            return {
                "schema_version": 1, "status": "workflow-completed", "issue": issue,
                "current_session": publication_current["session"]["session_name"],
                "recommended_recipe": None, "worklog_session_name": None,
                "resolved_inputs": {}, "missing_inputs": [], "suggested_invocation": None,
                "reason": "Il submit dello stack è concluso.",
            }
        publication = successful_step_output(publication_current, "configure_upstreams")
        verification = verification_from_lineage(publication_current, workflow) or report_input(publication_current, "verification_report")
        return propose_submit(issue, publication_current, publication, verification) if publication and verification else blocked(
            issue, publication_current, "Mancano publication_report o verification_report della recipe 07.")
    analysis = next((item["session"].get("session_name") for item in workflow
                     if item["phase"] == "02" and item["layer_id"] is None and item["session"].get("status") == "completed"), None)
    for layer in ordered:
        layer_id = layer.get("id")
        sequence = layer.get("sequence")
        if not isinstance(layer_id, str) or not LAYER_RE.fullmatch(layer_id) or not isinstance(sequence, int):
            return blocked(issue, breakdown_session, "La scomposizione stacked contiene un layer non valido.")
        layer_id = layer_id.upper()
        review = latest_layer_session(workflow, layer_id, "05")
        if review:
            if review["session"].get("status") == "completed":
                continue
            retry = retry_interrupted_stacked_review(issue, breakdown_session, review, workspace, workflow,
                                                      {**layer, "id": layer_id}, analysis)
            if retry:
                return retry
            return blocked(issue, review, "La review del layer è attiva: recuperare prima la stessa sessione.")
        implementation = latest_layer_session(workflow, layer_id, "04")
        if implementation:
            if implementation["session"].get("status") != "completed":
                if (requested_recipe == CORRECTION_RECIPE and implementation.get("action") in {"implement", "correction"}
                        and has_unpublished_correction_checkpoint(implementation)):
                    return correction_recommendation(issue, implementation, workspace, correction_instructions,
                                                     {**layer, "id": layer_id})
                return blocked(issue, implementation, "L'implementazione del layer è attiva: recuperare prima la stessa sessione.")
            branch, problem, recovery_warnings = layer_branch(workspace, issue, workflow, ordered, sequence)
            if problem or not branch:
                return blocked(issue, implementation, with_stack_warnings(problem or "Il branch del layer non è risolvibile.", recovery_warnings))
            stack, problem, warnings = implementation_stack_layer(workspace, issue, branch)
            if problem and not local_branch_exists(workspace, branch):
                return branch_recovery_required(
                    issue, implementation, workspace, branch,
                    with_stack_warnings(problem, recovery_warnings + warnings),
                )
            if problem:
                return blocked(issue, implementation, with_stack_warnings(problem, recovery_warnings + warnings))
            assert stack is not None
            implementation_input = implementation["session"].get("session_input")
            instructions = implementation_input.get("implementation_instructions", "") if isinstance(implementation_input, dict) else ""
            if not instructions and isinstance(implementation_input, dict):
                instructions = implementation_input.get("developer_instructions", "")
            if not isinstance(instructions, str):
                instructions = ""
            return stacked_recommendation(issue, breakdown_session, "acme-recipe-05-review-github-issue",
                layer_session_name(issue, breakdown_session["workflow_attempt"], layer_id, "05", "review"),
                {"issue": str(issue), "branch": stack["branch"], "base": stack["parent_branch"],
                 "stack_layer": json.dumps(stack, ensure_ascii=False, sort_keys=True),
                 "work_specification": json.dumps({**layer, "id": layer_id}, ensure_ascii=False, sort_keys=True),
                 "review_artifact_name": f"issue-{issue}-review.md", "implementation_instructions": instructions},
                {**layer, "id": layer_id}, with_stack_warnings("Il checkpoint 04 del layer è concluso.", recovery_warnings + warnings), analysis)
        expected = layer.get("existing_branch")
        if not isinstance(expected, str) or not expected:
            completed_branches: set[str] = set()
            for previous_sequence in range(sequence):
                previous_branch, problem, _ = layer_branch(workspace, issue, workflow, ordered, previous_sequence)
                if problem or not previous_branch:
                    return blocked(issue, breakdown_session, problem or "Il branch di un layer precedente non è risolvibile.")
                completed_branches.add(previous_branch)
            parent = None
            if sequence > 0:
                parent, problem, _ = layer_branch(workspace, issue, workflow, ordered, sequence - 1)
                if problem or not parent:
                    return blocked(issue, breakdown_session, problem or "Il branch del layer precedente non è risolvibile.")
            for candidate in issue_branches(workspace, issue):
                if candidate in completed_branches:
                    continue
                stack, _, _ = implementation_stack_layer(workspace, issue, candidate)
                if stack and (parent is None or stack["parent_branch"] == parent):
                    expected = candidate
                    break
        if isinstance(expected, str) and expected:
            stack, problem, warnings = implementation_stack_layer(workspace, issue, expected)
            if stack and branch_has_issue_commit(workspace, issue, expected, stack["parent_branch"]):
                return stacked_recommendation(issue, breakdown_session, "acme-recipe-04-adopt-github-issue-layer",
                    layer_session_name(issue, breakdown_session["workflow_attempt"], layer_id, "04", "implement"),
                    {"issue": str(issue), "layer": json.dumps({**layer, "id": layer_id}, ensure_ascii=False, sort_keys=True),
                     "branch": expected}, {**layer, "id": layer_id},
                    "Esiste un layer implementato senza checkpoint 04: adottarlo esplicitamente.", analysis)
        parent = None
        if sequence > 0:
            parent, problem, _ = layer_branch(workspace, issue, workflow, ordered, sequence - 1)
            if problem or not parent:
                return blocked(issue, breakdown_session, problem or "Manca il branch del layer precedente.")
        trunk, _, trunk_problem = trunk_branch(workspace)
        if trunk_problem or not trunk:
            return blocked(issue, breakdown_session, trunk_problem or "Manca il trunk configurato.")
        inputs = {"issue": str(issue), "layer": json.dumps({**layer, "id": layer_id}, ensure_ascii=False, sort_keys=True),
                  "base_branch": trunk}
        if sequence > 0:
            previous_review = latest_layer_session(workflow, str(ordered[sequence - 1].get("id", "")).upper(), "05")
            if previous_review and previous_review["session"].get("status") == "completed":
                review_path = artifact(previous_review["path"], f"issue-{issue}-review.md")
                if review_path:
                    inputs["previous_review"] = review_path
        return stacked_recommendation(issue, breakdown_session, "acme-recipe-04-implement-github-issue",
            layer_session_name(issue, breakdown_session["workflow_attempt"], layer_id, "04", "implement"), inputs,
            {**layer, "id": layer_id}, "È il primo layer stacked non implementato.", analysis, developer_instructions)
    last_review = latest_layer_session(workflow, str(ordered[-1].get("id", "")).upper(), "05")
    verification = successful_step_output(last_review, "verify_layer") if last_review else None
    if verification is None:
        return blocked(issue, breakdown_session, "Manca l'output verificato della review dell'ultimo layer stacked.")
    state, branch, head, commits = review_state(workspace, verification)
    if state == "advanced":
        return repeat_review(issue, last_review, verification, branch, head, commits, workflow)
    if state != "current":
        return blocked(issue, last_review, "Il branch è stato riscritto o non è più verificabile dopo la review.")
    return propose_push(issue, last_review, verification)


def report_completed(issue: int, current: dict[str, Any], workflow: list[dict[str, Any]], workspace: Path, trunk: str,
                     developer_instructions: str = "") -> dict[str, Any]:
    phase = current["phase"]
    workflow_attempt = current["workflow_attempt"]
    session_dir = current["path"]
    if phase in {"00", "01"}:
        name = next_session(issue, workflow_attempt, "02", "analyze")
        return recommendation(issue, current, "acme-recipe-02-analyze-github-issue-code", name,
                              {"issue": str(issue), "issue_number": str(issue)}, [])
    if phase == "02":
        analysis = artifact(session_dir, f"issue-{issue}-analysis.json")
        if not analysis:
            return blocked(issue, current, "Manca l'artefatto di analisi pronto della fase 02.")
        name = next_session(issue, workflow_attempt, "03", "breakdown")
        return recommendation(
            issue, current, "acme-recipe-03-breakdown-github-issue", name,
            {"issue_analysis": analysis}, [],
        )
    if phase == "03":
        breakdown_path = artifact(session_dir, f"issue-{issue}-breakdown.json")
        if not breakdown_path:
            return blocked(issue, current, "Manca l'artefatto di scomposizione della fase 03.")
        breakdown = read_json(Path(breakdown_path))
        mode = breakdown.get("mode")
        if mode == "single":
            evidence, problem = implementation_evidence(workspace, issue, trunk)
            if problem:
                return blocked(issue, current, problem)
            if evidence:
                branch, commit = evidence
                return blocked(
                    issue, current,
                    f"Implementazione già presente senza checkpoint 04: branch {branch}, commit {commit}. "
                    "Recuperare il journal runtime della recipe 04 o registrare il checkpoint prima di proseguire.",
                )
            name = next_session(issue, workflow_attempt, "04", "implement")
            return recommendation(
                issue, current, "acme-recipe-04-implement-github-issue", name,
                {"issue": str(issue), "base_branch": trunk,
                 **({"developer_instructions": developer_instructions} if developer_instructions else {})}, [],
                session_input_extra={"developer_instructions": developer_instructions} if developer_instructions else None,
            )
        if mode == "epic":
            return blocked(issue, current, "L'epic richiede la selezione della prima sub-issue non completata.")
        return blocked(issue, current, "La scomposizione non dichiara una modalità single o epic.")
    if phase == "04":
        layer, problem, warnings = implementation_stack_layer(workspace, issue)
        if problem:
            branch = recorded_branch(current)
            if branch and not local_branch_exists(workspace, branch):
                return branch_recovery_required(issue, current, workspace, branch, with_stack_warnings(problem, warnings))
            return blocked(issue, current, with_stack_warnings(problem, warnings))
        assert layer is not None
        name = next_session(issue, workflow_attempt, "05", "review")
        implementation_input = current["session"].get("session_input")
        instructions = implementation_input.get("implementation_instructions", "") if isinstance(implementation_input, dict) else ""
        if not instructions and isinstance(implementation_input, dict):
            instructions = implementation_input.get("developer_instructions", "")
        if not isinstance(instructions, str):
            instructions = ""
        return recommendation(
            issue, current, "acme-recipe-05-review-github-issue", name,
            {
                "issue": str(issue),
                "branch": layer["branch"],
                "base": layer["parent_branch"],
                "stack_layer": json.dumps(layer, ensure_ascii=False, sort_keys=True),
                "review_artifact_name": f"issue-{issue}-review.md",
                "implementation_instructions": instructions,
            }, [], with_stack_warnings("La precedente recipe è conclusa e il suo artefatto è disponibile.", warnings),
        )
    if phase == "05":
        verification = successful_step_output(current, "verify_layer")
        if verification is None:
            return blocked(issue, current, "Manca l'output verificato della recipe 05.")
        state, branch, head, commits = review_state(workspace, verification)
        if state == "advanced":
            return repeat_review(issue, current, verification, branch, head, commits, workflow)
        if state != "current":
            return blocked(issue, current, "Il branch è stato riscritto o non è più verificabile dopo la review.")
        return propose_push(issue, current, verification)
    if phase == "06":
        verification = successful_step_output(current, "verify_epic")
        return propose_push(issue, current, verification) if verification else blocked(issue, current, "Manca l'output accepted della recipe 06.")
    if phase == "07":
        publication = successful_step_output(current, "configure_upstreams")
        verification = verification_from_lineage(current, workflow) or report_input(current, "verification_report")
        return propose_submit(issue, current, publication, verification) if publication and verification else blocked(issue, current, "Mancano publication_report o verification_report della recipe 07.")
    if phase == "08":
        return {
            "schema_version": 1,
            "status": "workflow-completed",
            "issue": issue,
            "current_session": current["session"]["session_name"],
            "recommended_recipe": None,
            "worklog_session_name": None,
            "resolved_inputs": {},
            "missing_inputs": [],
            "suggested_invocation": None,
            "reason": "Il submit dello stack è concluso.",
        }
    return blocked(issue, current, "La fase conclusa non ha una recipe successiva definita.")


def with_stack_warnings(reason: str, warnings: list[str]) -> str:
    return reason if not warnings else f"{reason} Avvisi sugli stack locali: {' '.join(warnings)}"


def recommendation(issue: int, current: dict[str, Any], recipe: str, session_name: str,
                   resolved_inputs: dict[str, str], missing_inputs: list[str],
                   reason: str = "La precedente recipe è conclusa e il suo artefatto è disponibile.",
                   session_input_extra: dict[str, Any] | None = None) -> dict[str, Any]:
    inputs = dict(resolved_inputs)
    inputs["worklog_session_name"] = session_name
    session_input = {"issue": str(issue), "previous_session": current["session"]["session_name"]}
    if session_input_extra:
        session_input.update(session_input_extra)
    inputs["worklog_session_input"] = json.dumps(
        session_input,
        ensure_ascii=False, sort_keys=True,
    )
    require_declared_recipe_inputs(recipe, inputs)
    require_declared_recipe_inputs(recipe, {name: "" for name in missing_inputs})
    invocation_inputs = dict(inputs)
    for name in missing_inputs:
        invocation_inputs[name] = f"<{name}>"
    suggested_invocation = " ".join(
        [f"${recipe}"] + [f"{name}={json.dumps(value, ensure_ascii=False)}"
                             for name, value in invocation_inputs.items()]
    )
    return {
        "schema_version": 1,
        "status": "ready" if not missing_inputs else "input-required",
        "issue": issue,
        "current_session": current["session"]["session_name"],
        "recommended_recipe": recipe,
        "worklog_session_name": session_name,
        "resolved_inputs": inputs,
        "missing_inputs": missing_inputs,
        "suggested_invocation": suggested_invocation,
        "reason": reason,
    }


def blocked(issue: int, current: dict[str, Any], reason: str) -> dict[str, Any]:
    return {
        "schema_version": 1,
        "status": "manual-assessment-required",
        "issue": issue,
        "current_session": current["session"]["session_name"],
        "recommended_recipe": None,
        "worklog_session_name": None,
        "resolved_inputs": {},
        "missing_inputs": [],
        "suggested_invocation": None,
        "reason": reason,
    }


def branch_recovery_required(issue: int, current: dict[str, Any], workspace: Path, branch: str, reason: str) -> dict[str, Any]:
    """Request the explicit recovery command without making this offline report mutate Git."""
    branch = registered_branch(workspace, issue) or branch
    invocation = f"$acme-cmd-prepare-git-recipe-branch issue={json.dumps(str(issue))}"
    return {
        "schema_version": 1,
        "status": "branch-recovery-required",
        "issue": issue,
        "current_session": current["session"]["session_name"],
        "recommended_recipe": None,
        "worklog_session_name": None,
        "resolved_inputs": {"issue": str(issue), "branch": branch},
        "missing_inputs": [],
        "suggested_invocation": invocation,
        "reason": (
            "Il branch registrato dalla recipe non è disponibile in uno stack locale coerente. "
            f"Eseguire il comando di recupero e poi rilanciare il report. Dettaglio: {reason}"
        ),
    }


def published_branch_recovery(issue: int, current: dict[str, Any], workspace: Path) -> dict[str, Any] | None:
    """Do not recommend work on a publication that this worktree cannot use.

    A publication checkpoint is the hand-off contract between worktrees. The
    local branch may be ahead (for example after a local review fix), but it
    must still contain the OID that was published. Looking only for a branch
    name allowed a stale pre-rebase branch to be treated as ready.
    """
    for layer in published_layers(workspace, issue):
        branch, published_oid = layer["branch"], layer["remote_oid"]
        if not local_branch_exists(workspace, branch):
            return branch_recovery_required(
                issue, current, workspace, branch,
                f"Il branch pubblicato {branch} non esiste localmente (OID pubblicato {published_oid}).",
            )
        contains = subprocess.run(
            ["git", "-C", str(workspace), "merge-base", "--is-ancestor", published_oid, branch],
            capture_output=True, text=True, check=False,
        ).returncode == 0
        if not contains:
            return branch_recovery_required(
                issue, current, workspace, branch,
                f"Il branch locale {branch} non contiene l'OID pubblicato {published_oid}; è richiesto il recupero dal remote.",
            )
    return None


def stack_rebase_required(issue: int, current: dict[str, Any], workspace: Path) -> dict[str, Any] | None:
    """Recognize an intact published first layer whose local trunk moved on.

    This is deliberately offline: it examines only the worklog and refs already
    present in the worktree.  Missing refs remain a recovery problem for the
    normal report path; unrelated histories remain a blocking diagnostic.
    """
    layers = published_layers(workspace, issue)
    if not layers:
        return None
    try:
        trunk, ordered = order_layers(layers)
    except SystemExit:
        return None
    first = ordered[0]
    branch = first["branch"]
    if not local_branch_exists(workspace, trunk) or not local_branch_exists(workspace, branch):
        return None
    remote = first["remote"]

    def available_ref(ref: str) -> bool:
        return subprocess.run(
            ["git", "-C", str(workspace), "rev-parse", "--verify", "--quiet", f"{ref}^{{commit}}"],
            capture_output=True, text=True, check=False,
        ).returncode == 0

    remote_trunk = f"refs/remotes/{remote}/{trunk}"
    remote_branch = f"refs/remotes/{remote}/{branch}"
    trunk_ref = remote_trunk if available_ref(remote_trunk) else trunk
    branch_ref = remote_branch if available_ref(remote_branch) else branch
    is_ancestor = subprocess.run(
        ["git", "-C", str(workspace), "merge-base", "--is-ancestor", trunk_ref, branch_ref],
        capture_output=True, text=True, check=False,
    )
    if is_ancestor.returncode == 0:
        return None
    base_result = subprocess.run(
        ["git", "-C", str(workspace), "merge-base", trunk_ref, branch_ref], capture_output=True, text=True, check=False,
    )
    base = base_result.stdout.strip() if base_result.returncode == 0 else ""
    if not base:
        return None
    base_in_trunk = subprocess.run(
        ["git", "-C", str(workspace), "merge-base", "--is-ancestor", base, trunk_ref],
        capture_output=True, text=True, check=False,
    ).returncode == 0
    total = subprocess.run(
        ["git", "-C", str(workspace), "rev-list", "--count", f"{base}..{branch_ref}"],
        capture_output=True, text=True, check=False,
    ).stdout.strip()
    exclusive = subprocess.run(
        ["git", "-C", str(workspace), "rev-list", "--count", f"{base}..{branch_ref}", "--not", trunk_ref],
        capture_output=True, text=True, check=False,
    ).stdout.strip()
    checkpoints = [first[key] for key in ("base_oid", "parent_oid") if first.get(key)]
    checkpoints_match = all(subprocess.run(
        ["git", "-C", str(workspace), "merge-base", "--is-ancestor", checkpoint, base],
        capture_output=True, text=True, check=False,
    ).returncode == 0 for checkpoint in checkpoints)
    if not base_in_trunk or total != exclusive or not checkpoints_match:
        return None
    trunk_oid = subprocess.run(
        ["git", "-C", str(workspace), "rev-parse", trunk_ref], capture_output=True, text=True, check=False,
    ).stdout.strip()
    return {
        "schema_version": 1,
        "status": "stack-rebase-required",
        "issue": issue,
        "current_session": current["session"]["session_name"],
        "recommended_recipe": None,
        "worklog_session_name": None,
        "resolved_inputs": {"issue": str(issue), "branch": branch, "trunk": trunk,
                            "trunk_oid": trunk_oid, "layer_base_oid": base},
        "missing_inputs": [],
        "suggested_invocation": None,
        "reason": (
            f"Il trunk {trunk} è avanzato a {trunk_oid} dopo la pubblicazione del layer {branch} "
            f"(base {base}). Rieseguire il rebase e la ripubblicazione dello stack con la procedura manuale "
            "documentata; il report e il recupero non eseguono rebase o push."
        ),
    }


def stack_republish_required(issue: int, current: dict[str, Any], workspace: Path) -> dict[str, Any] | None:
    """Detect a locally available, patch-equivalent stack rewritten after rebase."""
    layers = published_layers(workspace, issue)
    if not layers:
        return None
    try:
        trunk, ordered = order_layers(layers)
    except SystemExit:
        return None
    remote = ordered[0]["remote"]
    remote_trunk = f"refs/remotes/{remote}/{trunk}"
    if not local_branch_exists(workspace, trunk) or not local_branch_exists(workspace, ordered[-1]["branch"]):
        return None
    if subprocess.run(["git", "-C", str(workspace), "rev-parse", "--verify", "--quiet", f"{remote_trunk}^{{commit}}"], capture_output=True, text=True).returncode:
        return None
    old_by_branch = {layer["branch"]: layer for layer in ordered}
    rewritten = False
    for index, layer in enumerate(ordered):
        branch, parent, old_tip = layer["branch"], layer["parent_branch"], layer["remote_oid"]
        remote_ref = f"refs/remotes/{remote}/{branch}"
        if not local_branch_exists(workspace, branch) or subprocess.run(
                ["git", "-C", str(workspace), "rev-parse", "--verify", "--quiet", f"{remote_ref}^{{commit}}"], capture_output=True, text=True).returncode:
            return None
        local_oid = subprocess.run(["git", "-C", str(workspace), "rev-parse", branch], capture_output=True, text=True).stdout.strip()
        remote_oid = subprocess.run(["git", "-C", str(workspace), "rev-parse", remote_ref], capture_output=True, text=True).stdout.strip()
        if local_oid != remote_oid:
            return None
        new_parent = trunk if index == 0 else ordered[index - 1]["branch"]
        if parent != new_parent or subprocess.run(["git", "-C", str(workspace), "merge-base", "--is-ancestor", new_parent, branch], capture_output=True, text=True).returncode:
            return None
        if subprocess.run(["git", "-C", str(workspace), "merge-base", "--is-ancestor", old_tip, remote_ref], capture_output=True, text=True).returncode == 0:
            continue
        if subprocess.run(["git", "-C", str(workspace), "cat-file", "-e", f"{old_tip}^{{commit}}"], capture_output=True, text=True).returncode:
            return None
        old_base = layer.get("base_oid") if index == 0 else old_by_branch[parent]["remote_oid"]
        if not old_base:
            merge = subprocess.run(["git", "-C", str(workspace), "merge-base", trunk, old_tip], capture_output=True, text=True)
            old_base = merge.stdout.strip() if merge.returncode == 0 else ""
        if not old_base:
            return None
        def ids(base: str, tip: str) -> list[str]:
            commits = subprocess.run(["git", "-C", str(workspace), "rev-list", "--reverse", f"{base}..{tip}"], capture_output=True, text=True).stdout.splitlines()
            values: list[str] = []
            for commit in commits:
                shown = subprocess.run(["git", "-C", str(workspace), "show", "--format=", "--no-ext-diff", commit], capture_output=True, text=True)
                patch = subprocess.run(["git", "-C", str(workspace), "patch-id", "--stable"], input=shown.stdout, capture_output=True, text=True).stdout.split()
                if not patch:
                    return []
                values.append(patch[0])
            return values
        if ids(old_base, old_tip) != ids(new_parent, branch):
            return None
        rewritten = True
    if not rewritten:
        return None
    return {
        "schema_version": 1, "status": "stack-republish-required", "issue": issue,
        "current_session": current["session"]["session_name"],
        "recommended_recipe": "acme-recipe-resume-github-issue-workflow",
        "worklog_session_name": current["session"]["session_name"],
        "resolved_inputs": {"issue": str(issue)}, "missing_inputs": ["publication_authorized"],
        "suggested_invocation": f'$acme-recipe-resume-github-issue-workflow issue="{issue}" publication_authorized="<publication_authorized>"',
        "reason": "Lo stack remoto è stato riscritto dopo il rebase ma i patch-id coincidono; registrare la ripubblicazione prima di proseguire.",
    }


def unreconciled_published_rewrite(issue: int, workspace: Path) -> str | None:
    """Keep an unverified remote rewrite from being mistaken for a ready stack."""
    for layer in published_layers(workspace, issue):
        remote_ref = f"refs/remotes/{layer['remote']}/{layer['branch']}"
        remote_exists = subprocess.run(
            ["git", "-C", str(workspace), "rev-parse", "--verify", "--quiet", f"{remote_ref}^{{commit}}"],
            capture_output=True, text=True, check=False,
        ).returncode == 0
        if remote_exists and subprocess.run(
                ["git", "-C", str(workspace), "merge-base", "--is-ancestor", layer["remote_oid"], remote_ref],
                capture_output=True, text=True, check=False).returncode:
            return f"Il remote del layer {layer['branch']} è stato riscritto e non è riconciliabile con i checkpoint pubblicati."
    return None


def add_warnings(report: dict[str, Any], warnings: list[str]) -> dict[str, Any]:
    if warnings:
        report["warnings"] = warnings
    return report


def stack_trunk_warnings(workspace: Path, configured_trunk: str) -> list[str]:
    """Expose conflicting gh-stack trunks as report warnings without trusting them."""
    metadata = subprocess.run(["git", "-C", str(workspace), "rev-parse", "--git-path", "gh-stack"],
                              capture_output=True, text=True, check=False)
    if metadata.returncode:
        return []
    path = Path(metadata.stdout.strip())
    if not path.is_absolute():
        path = workspace / path
    try:
        stacks = json.loads(path.read_text(encoding="utf-8")).get("stacks", [])
    except (OSError, UnicodeError, json.JSONDecodeError):
        return []
    if not isinstance(stacks, list):
        return []
    return [f"Stack dichiara il trunk {trunk}, diverso dal trunk configurato {configured_trunk}."
            for stack in stacks if isinstance(stack, dict)
            for trunk in [stack.get("trunk", {}).get("branch") if isinstance(stack.get("trunk"), dict) else None]
            if isinstance(trunk, str) and trunk and trunk != configured_trunk]


def new_workflow_report(issue: int, requested_recipe: str | None,
                        developer_instructions: str, creation_session: str | None = None) -> dict[str, Any]:
    """Return the only recipes that may start a workflow without local worklog."""
    if requested_recipe in NEW_WORKFLOW_RECIPES:
        phase, action = NEW_WORKFLOW_RECIPES[requested_recipe]
        session_name = next_session(issue, 1, phase, action)
        session_input = {"issue": str(issue)}
        if creation_session:
            session_input["creation_session"] = creation_session
        if developer_instructions:
            session_input["developer_instructions"] = developer_instructions
        resolved_inputs = {
            "issue": str(issue),
            "worklog_session_name": session_name,
            "worklog_session_input": json.dumps(session_input, ensure_ascii=False, sort_keys=True),
        }
        if requested_recipe == "acme-recipe-02-analyze-github-issue-code":
            resolved_inputs["issue_number"] = str(issue)
        require_declared_recipe_inputs(requested_recipe, resolved_inputs)
        suggested_invocation = " ".join(
            [f"${requested_recipe}"] + [f"{name}={json.dumps(value, ensure_ascii=False)}"
                                      for name, value in resolved_inputs.items()]
        )
        return {
            "schema_version": 1,
            "status": "ready",
            "issue": issue,
            "current_session": None,
            "recommended_recipe": requested_recipe,
            "worklog_session_name": session_name,
            "resolved_inputs": resolved_inputs,
            "missing_inputs": [],
            "suggested_invocation": suggested_invocation,
            "reason": ("La recipe 00 pending che ha creato la issue è collegata al primo tentativo del workflow."
                       if creation_session else "Non esistono sessioni locali: viene aperto il primo tentativo del workflow."),
        }
    return {
        "schema_version": 1,
        "status": "manual-assessment-required",
        "issue": issue,
        "current_session": None,
        "recommended_recipe": None,
        "worklog_session_name": None,
        "resolved_inputs": {},
        "missing_inputs": [],
        "suggested_invocation": None,
        "reason": (
            "Non esistono sessioni locali per questa issue. Le recipe 03-06 richiedono gli "
            "artefatti delle fasi precedenti; avviare prima la recipe 01 o 02."
        ),
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("operation", choices=("report", "migrate"))
    parser.add_argument("--issue", required=True, help="Numero della issue, con # opzionale, oppure pending")
    parser.add_argument("--issue-number", default="", help="Numero reale quando --issue è pending")
    parser.add_argument("--requested-recipe", help="Recipe che il runtime sta pianificando")
    parser.add_argument("--developer-instructions", default="", help="Vincoli iniziali dello sviluppatore")
    parser.add_argument("--correction-instructions", default="", help="Correzioni esplicite da applicare al branch non pubblicato")
    parser.add_argument("--new-workflow-attempt", default="", help='"true" per aprire un nuovo attempt della fase richiesta')
    parser.add_argument("--reason", default="", help="Motivo obbligatorio per un nuovo workflow attempt")
    args = parser.parse_args()
    pending = args.issue.strip() == "pending"
    if pending:
        if not args.issue_number:
            fail('issue-number is required when issue is "pending"')
        issue = parse_issue(args.issue_number)
    else:
        issue = parse_issue(args.issue)
        if args.issue_number:
            fail('issue-number can be used only when issue is "pending"')
    if args.new_workflow_attempt not in {"", "true"}:
        fail('new-workflow-attempt must be "true" or empty')
    workspace = find_workspace(Path.cwd())
    if args.operation == "migrate":
        if pending:
            fail('migrate requires a numeric issue, not "pending"')
        moved = moved_creation_sessions(workspace, issue)
        if len(moved) != 1:
            fail(f"la migrazione richiede una sola sessione 00 sotto issue-{issue}/attempt-01")
        normalized = normalize_moved_creation(moved[0]["path"], issue)
        print(json.dumps({"schema_version": 1, "status": "migrated", "issue": issue,
                          "session_name": normalized["session_name"]}, ensure_ascii=False, indent=2, sort_keys=True))
        return 0
    trunk, context_warnings, trunk_problem = trunk_branch(workspace)
    if trunk_problem:
        current = {"session": {"session_name": None}}
        print(json.dumps(blocked(issue, current, trunk_problem), ensure_ascii=False, indent=2, sort_keys=True))
        return 0
    assert trunk is not None
    context_warnings += stack_trunk_warnings(workspace, trunk)
    issue_root = workspace / ".ai-evo-work" / f"issue-{issue}"
    candidates = sessions(issue_root) if issue_root.is_dir() else []
    workflow = latest_workflow(candidates)
    if pending:
        creations = pending_creation_sessions(workspace, issue)
        moved = moved_creation_sessions(workspace, issue)
        if len(creations) > 1:
            current = {"session": {"session_name": None}}
            result = blocked(issue, current, f"Più recipe 00 pending registrano la creazione della issue #{issue}; indicare una sessione specifica.")
            print(json.dumps(add_warnings(result, context_warnings), ensure_ascii=False, indent=2, sort_keys=True))
            return 0
        if len(moved) > 1:
            current = {"session": {"session_name": None}}
            result = blocked(issue, current, f"Più sessioni 00 già spostate registrano la creazione della issue #{issue}.")
            print(json.dumps(add_warnings(result, context_warnings), ensure_ascii=False, indent=2, sort_keys=True))
            return 0
        if creations:
            promoted = promote_pending_creation(workspace, issue, creations[0])
            candidates = sessions(issue_root)
            workflow = latest_workflow(candidates)
            # The requested 01 or 02 is the first session after a design creation;
            # returning it here ensures its input names the canonical location.
            result = new_workflow_report(issue, args.requested_recipe, args.developer_instructions,
                                         promoted["session"].get("session_name"))
            print(json.dumps(add_warnings(result, context_warnings), ensure_ascii=False, indent=2, sort_keys=True))
            return 0
        if moved and len(workflow) == 1 and workflow[0]["phase"] == "00":
            creation_name = str(moved[0]["path"].relative_to(workspace / ".ai-evo-work"))
            result = new_workflow_report(issue, args.requested_recipe, args.developer_instructions, creation_name)
            print(json.dumps(add_warnings(result, context_warnings), ensure_ascii=False, indent=2, sort_keys=True))
            return 0
    if not workflow:
        if pending:
            if not moved:
                current = {"session": {"session_name": None}}
                reason = f"Nessuna recipe 00 conclusa in issue-pending registra la creazione della issue #{issue}."
                result = blocked(issue, current, reason)
            else:
                result = new_workflow_report(
                    issue, args.requested_recipe, args.developer_instructions,
                    str(moved[0]["path"].relative_to(workspace / ".ai-evo-work")),
                )
        else:
            result = new_workflow_report(issue, args.requested_recipe, args.developer_instructions)
        print(json.dumps(add_warnings(result, context_warnings), ensure_ascii=False, indent=2, sort_keys=True))
        return 0
    if args.new_workflow_attempt == "true" and args.requested_recipe == "acme-recipe-03-breakdown-github-issue":
        current = latest_phase(workflow)
        result = (new_breakdown_attempt(issue, workflow, candidates, args.reason.strip()) if args.reason.strip()
                  else blocked(issue, current, "Il motivo è obbligatorio per aprire un nuovo workflow attempt."))
        print(json.dumps(add_warnings(result, context_warnings), ensure_ascii=False, indent=2, sort_keys=True))
        return 0
    current = latest_phase(workflow)
    recovery = published_branch_recovery(issue, current, workspace)
    if recovery:
        print(json.dumps(add_warnings(recovery, context_warnings), ensure_ascii=False, indent=2, sort_keys=True))
        return 0
    republish = stack_republish_required(issue, current, workspace)
    if republish:
        print(json.dumps(add_warnings(republish, context_warnings), ensure_ascii=False, indent=2, sort_keys=True))
        return 0
    rewrite_problem = unreconciled_published_rewrite(issue, workspace)
    if rewrite_problem:
        result = blocked(issue, current, rewrite_problem)
        print(json.dumps(add_warnings(result, context_warnings), ensure_ascii=False, indent=2, sort_keys=True))
        return 0
    rebase = stack_rebase_required(issue, current, workspace)
    if rebase:
        print(json.dumps(add_warnings(rebase, context_warnings), ensure_ascii=False, indent=2, sort_keys=True))
        return 0
    # A stacked breakdown owns several independent 04/05 session pairs.  Resolve it
    # from its ordered layer map instead of treating the numerically latest phase as
    # the next global phase.
    stacked_breakdowns = [item for item in workflow if item["phase"] == "03" and item["layer_id"] is None
                          and item["session"].get("status") == "completed"]
    if stacked_breakdowns:
        breakdown_current = max(stacked_breakdowns, key=lambda item: item["phase_attempt"])
        breakdown_path = artifact(breakdown_current["path"], f"issue-{issue}-breakdown.json")
        if breakdown_path:
            breakdown = read_json(Path(breakdown_path))
            if breakdown.get("mode") == "stacked":
                result = report_stacked(issue, breakdown_current, workflow, workspace, breakdown, args.developer_instructions,
                                        args.requested_recipe, args.correction_instructions)
                print(json.dumps(add_warnings(result, context_warnings), ensure_ascii=False, indent=2, sort_keys=True))
                return 0
    current = latest_phase(workflow)
    status = current["session"].get("status")
    if status == "completed":
        result = report_completed(issue, current, workflow, workspace, trunk, args.developer_instructions)
    elif status == "active":
        entries = current["session"].get("entries")
        failed = isinstance(entries, list) and bool(entries) and entries[-1].get("outcome") == "failed"
        if (args.requested_recipe == CORRECTION_RECIPE and current["phase"] == "04"
                and current.get("action") in {"implement", "correction"} and not failed
                and has_unpublished_correction_checkpoint(current)):
            result = correction_recommendation(issue, current, workspace, args.correction_instructions)
        else:
            reason = "L'ultimo checkpoint della sessione è fallito: recuperare prima piano e journal runtime della stessa recipe." if failed else "La sessione è attiva: recuperare prima piano e journal runtime della stessa recipe."
            result = blocked(issue, current, reason)
    else:
        result = blocked(issue, current, "Lo stato della sessione non è riconosciuto.")
    print(json.dumps(add_warnings(result, context_warnings), ensure_ascii=False, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
