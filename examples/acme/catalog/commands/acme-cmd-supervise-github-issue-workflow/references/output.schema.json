{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "issue", "profile", "reason", "missing_inputs", "resume", "summary", "daily_activity"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["completed-local", "completed-draft-prs", "input-required", "handoff-required", "blocked", "incomplete", "policy-violation"]},
    "issue": {"type": "integer", "minimum": 1},
    "profile": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "missing_inputs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "resume": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["issue", "profile"],
      "properties": {
        "issue": {"type": "integer", "minimum": 1},
        "profile": {"type": "string", "minLength": 1}
      }
    },
    "summary": {
      "type": ["object", "null"]
    },
    "daily_activity": {"type": "null"}
  }
}
