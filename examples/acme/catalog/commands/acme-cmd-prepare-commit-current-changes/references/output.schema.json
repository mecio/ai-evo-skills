{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "issue",
        "branch",
        "initial_oid",
        "git_identity",
        "files",
        "summary",
        "risks",
        "missing_verifications",
        "message"
      ],
      "properties": {
        "status": {
          "const": "ready"
        },
        "issue": {
          "type": "integer",
          "minimum": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "initial_oid": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "git_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "email"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "email": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "change",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "change": {
                "enum": [
                  "added",
                  "modified",
                  "deleted"
                ]
              },
              "sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "change": {
                      "const": "deleted"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "sha256": {
                      "type": "null"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                }
              }
            ]
          },
          "minItems": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "missing_verifications": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "skipped"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  ]
}
