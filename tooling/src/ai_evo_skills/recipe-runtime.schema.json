{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-evo-skills:schema:recipe-runtime:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan",
    "results"
  ],
  "properties": {
    "plan": {
      "$ref": "#/$defs/plan"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "step"
      ],
      "properties": {
        "type": {
          "const": "ai-evo-step-output"
        },
        "step": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
        }
      }
    },
    "skipped": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "step",
        "reason"
      ],
      "properties": {
        "type": {
          "const": "ai-evo-step-skipped"
        },
        "step": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
        },
        "reason": {
          "const": "condition-false"
        }
      }
    },
    "value": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/reference"
        }
      ]
    },
    "conditionSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all"
      ],
      "properties": {
        "all": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "equals"
            ],
            "properties": {
              "value": {
                "$ref": "#/$defs/value"
              },
              "equals": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "record": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "step",
            "status",
            "output"
          ],
          "properties": {
            "step": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
            },
            "status": {
              "const": "succeeded"
            },
            "output": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "step",
            "status",
            "output"
          ],
          "properties": {
            "step": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
            },
            "status": {
              "const": "skipped"
            },
            "output": {
              "$ref": "#/$defs/skipped"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "step",
            "status",
            "exit_code"
          ],
          "properties": {
            "step": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
            },
            "status": {
              "const": "failed"
            },
            "exit_code": {
              "type": "integer",
              "minimum": 1,
              "maximum": 255
            }
          }
        }
      ]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "recipe",
        "profile",
        "execution",
        "result"
      ],
      "properties": {
        "version": {
          "const": "1.0"
        },
        "recipe": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "profile",
            "adapter",
            "application",
            "delegated_cli_arguments",
            "instructions",
            "reporting"
          ],
          "properties": {
            "version": {
              "const": "1.0"
            },
            "profile": {
              "type": "string",
              "minLength": 1
            },
            "adapter": {
              "type": "string",
              "minLength": 1
            },
            "application": {
              "enum": [
                "instructions",
                "native-cli-and-instructions"
              ]
            },
            "delegated_cli_arguments": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "instructions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "reporting": {
              "enum": [
                "none",
                "summary",
                "full"
              ]
            }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "failure",
            "steps"
          ],
          "properties": {
            "mode": {
              "const": "sequential"
            },
            "failure": {
              "const": "fail-fast"
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "allOf": [
                  {
                    "$ref": "urn:ai-evo-skills:schema:planned-step:1.0"
                  },
                  {
                    "required": [
                      "id",
                      "uses"
                    ]
                  }
                ]
              }
            },
            "conditions": {
              "const": "exact-equals-v1"
            }
          }
        },
        "result": {
          "$ref": "#/$defs/reference"
        }
      }
    }
  }
}
