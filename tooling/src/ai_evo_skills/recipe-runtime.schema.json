{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-evo-skills:schema:recipe-runtime:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan",
    "results"
  ],
  "properties": {
    "plan": {
      "$ref": "#/$defs/plan"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "step"
      ],
      "properties": {
        "type": {
          "const": "ai-evo-step-output"
        },
        "step": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.(?:[a-z][a-z0-9_]*|[0-9]+))*$"
        }
      }
    },
    "skipped": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "step",
        "reason"
      ],
      "properties": {
        "type": {
          "const": "ai-evo-step-skipped"
        },
        "step": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.(?:[a-z][a-z0-9_]*|[0-9]+))*$"
        },
        "reason": {
          "const": "condition-false"
        }
      }
    },
    "value": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/reference"
        },
        {
          "$ref": "#/$defs/foreachItem"
        }
      ]
    },
    "foreachItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "const": "ai-evo-foreach-item"
        }
      }
    },
    "conditionSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all"
      ],
      "properties": {
        "all": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "equals"
            ],
            "properties": {
              "value": {
                "$ref": "#/$defs/value"
              },
              "equals": {
                "type": "string"
              },
              "normalize": {
                "const": "trim"
              }
            }
          }
        }
      }
    },
    "record": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "step",
            "status",
            "output"
          ],
          "properties": {
            "step": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(\\.(?:[a-z][a-z0-9_]*|[0-9]+))*$"
            },
            "status": {
              "const": "succeeded"
            },
            "output": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "step",
            "status",
            "output"
          ],
          "properties": {
            "step": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(\\.(?:[a-z][a-z0-9_]*|[0-9]+))*$"
            },
            "status": {
              "const": "skipped"
            },
            "output": {
              "$ref": "#/$defs/skipped"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "step",
            "status",
            "exit_code"
          ],
          "properties": {
            "step": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*(\\.(?:[a-z][a-z0-9_]*|[0-9]+))*$"
            },
            "status": {
              "const": "failed"
            },
            "exit_code": {
              "type": "integer",
              "minimum": 1,
              "maximum": 255
            }
          }
        }
      ]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "recipe",
        "profile",
        "execution",
        "result"
      ],
      "properties": {
        "version": {
          "const": "1.0"
        },
        "recipe": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z]{3,6}-recipe-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "profile",
            "adapter",
            "application",
            "delegated_cli_arguments",
            "instructions",
            "reporting"
          ],
          "properties": {
            "version": {
              "const": "1.0"
            },
            "profile": {
              "type": "string",
              "minLength": 1
            },
            "adapter": {
              "type": "string",
              "minLength": 1
            },
            "application": {
              "enum": [
                "instructions",
                "native-cli-and-instructions"
              ]
            },
            "delegated_cli_arguments": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "instructions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "reporting": {
              "enum": [
                "none",
                "summary",
                "full"
              ]
            }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "failure",
            "steps"
          ],
          "properties": {
            "mode": {
              "const": "sequential"
            },
            "failure": {
              "const": "fail-fast"
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  {
                    "allOf": [
                      { "$ref": "urn:ai-evo-skills:schema:planned-step:1.0" },
                      { "required": ["id", "uses"] }
                    ]
                  },
                  { "$ref": "#/$defs/foreach" }
                ]
              }
            },
            "conditions": {
              "const": "exact-equals-v1"
            },
            "iterations": {
              "const": "json-array-sequential-v1"
            }
          }
        },
        "result": {
          "$ref": "#/$defs/reference"
        }
      }
    },
    "foreach": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "for_each", "steps", "result"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.(?:[a-z][a-z0-9_]*|[0-9]+))*$"
        },
        "for_each": {
          "type": "object",
          "additionalProperties": false,
          "required": ["items"],
          "properties": {
            "items": { "$ref": "#/$defs/value" }
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              { "$ref": "urn:ai-evo-skills:schema:planned-step:1.0" },
              { "required": ["id", "uses"] }
            ]
          }
        },
        "result": { "$ref": "#/$defs/reference" }
      }
    }
  }
}
